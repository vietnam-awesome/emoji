{
  "name": "@eplus-dev/emoji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "emoji-store:hydrate": "node scripts/emoji-store.mjs hydrate",
    "emoji-store:shard": "node scripts/emoji-store.mjs shard",
    "taxonomy:report": "node scripts/classify-emojis.mjs",
    "taxonomy:apply": "node scripts/classify-emojis.mjs --write",
    "dev": "astro dev",
    "build:static-data": "node scripts/build-static-search.mjs",
    "build": "npm run build:static-data && astro build",
    "preview": "astro preview",
    "sync": "node scripts/sync.mjs",
    "import:community": "node scripts/import-community.mjs",
    "import:emojigg": "node scripts/import-emojigg.mjs",
    "import:slackmojis": "node scripts/import-slackmojis.mjs",
    "import:discords": "node scripts/import-discords.mjs",
    "import:eplus": "node scripts/import-eplus.mjs",
    "turso:schema": "node scripts/sync-turso.mjs --schema-only",
    "turso:sync": "node scripts/sync-turso.mjs",
    "turso:verify": "node scripts/verify-turso.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:data": "node scripts/verify-data.mjs",
    "check:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "7.3.1",
    "playwright": "1.55.0",
    "tailwindcss": "^4.0.0"
  }
}
