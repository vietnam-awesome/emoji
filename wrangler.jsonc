{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eplus-emoji",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
