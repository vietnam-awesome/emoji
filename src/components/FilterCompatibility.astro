<script is:inline>
  (() => {
    const explorer = document.querySelector('#explorer');
    const category = document.querySelector('#category-filter');
    const source = document.querySelector('#source-filter');
    const motion = document.querySelector('#motion-filter');
    const clear = document.querySelector('#clear-filters');
    if (!explorer || !category || !source || !motion) return;

    const searchRoot = explorer.dataset.searchRoot || '/search';
    const manifestUrl = `${searchRoot.replace(/\/$/, '')}/manifest.json`;
    const empty = { total: 0, animated: 0, static: 0 };
    const number = new Intl.NumberFormat('en-US');
    let data = null;

    category.disabled = true;
    source.disabled = true;
    motion.disabled = true;

    function metric(bucket, motionValue = motion.value) {
      if (!bucket) return 0;
      if (motionValue === 'yes') return Number(bucket.animated || 0);
      if (motionValue === 'no') return Number(bucket.static || 0);
      return Number(bucket.total || 0);
    }

    function combo(categoryValue = category.value, sourceValue = source.value) {
      if (!data) return empty;
      if (categoryValue && sourceValue) return data.categorySource?.[categoryValue]?.[sourceValue] || empty;
      if (categoryValue) return data.categories?.[categoryValue] || empty;
      if (sourceValue) return data.sources?.[sourceValue] || empty;
      return data.totals || empty;
    }

    function optionBaseLabel(option) {
      if (!option.dataset.filterLabel) {
        option.dataset.filterLabel = String(option.textContent || '').split('·')[0].trim();
      }
      return option.dataset.filterLabel;
    }

    function updateSelect(select, countForValue) {
      for (const option of select.options) {
        const count = countForValue(option.value);
        const label = optionBaseLabel(option);
        option.textContent = `${label} · ${number.format(count)}`;
        option.disabled = Boolean(option.value) && count === 0 && !option.selected;
      }
    }

    function updateOptions() {
      if (!data) return;
      const selectedSource = source.value;
      const selectedCategory = category.value;

      updateSelect(category, (value) => {
        if (!value) return metric(selectedSource ? data.sources?.[selectedSource] : data.totals);
        return metric(selectedSource ? data.categorySource?.[value]?.[selectedSource] : data.categories?.[value]);
      });

      updateSelect(source, (value) => {
        if (!value) return metric(selectedCategory ? data.categories?.[selectedCategory] : data.totals);
        return metric(selectedCategory ? data.categorySource?.[selectedCategory]?.[value] : data.sources?.[value]);
      });

      const current = combo();
      for (const option of motion.options) {
        const label = optionBaseLabel(option);
        const count = option.value === 'yes'
          ? Number(current.animated || 0)
          : option.value === 'no'
            ? Number(current.static || 0)
            : Number(current.total || 0);
        option.textContent = `${label} · ${number.format(count)}`;
        option.disabled = Boolean(option.value) && count === 0 && !option.selected;
      }
    }

    function reconcile(preferred = '') {
      if (!data || metric(combo()) > 0) return false;

      const before = `${category.value}|${source.value}|${motion.value}`;
      if (preferred === 'category' && source.value) source.value = '';
      else if (preferred === 'source' && category.value) category.value = '';
      else if (preferred === 'motion') {
        if (source.value) source.value = '';
        if (metric(combo()) === 0 && category.value) category.value = '';
      } else if (source.value) {
        source.value = '';
      }

      if (metric(combo()) === 0 && motion.value) motion.value = '';
      return before !== `${category.value}|${source.value}|${motion.value}`;
    }

    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!data || (target !== category && target !== source && target !== motion)) return;
      const preferred = target === category ? 'category' : target === source ? 'source' : 'motion';
      reconcile(preferred);
      updateOptions();
    }, true);

    clear?.addEventListener('click', () => {
      queueMicrotask(updateOptions);
    }, true);

    fetch(manifestUrl, { cache: 'force-cache' })
      .then((response) => {
        if (!response.ok) throw new Error(`Filter manifest returned HTTP ${response.status}`);
        return response.json();
      })
      .then((manifest) => {
        if (!manifest?.compatibility) throw new Error('Filter compatibility data is missing from manifest');
        data = manifest.compatibility;

        const changed = reconcile();
        updateOptions();
        category.disabled = false;
        source.disabled = false;
        motion.disabled = false;

        if (changed) {
          const target = source.value ? source : category.value ? category : motion;
          target.dispatchEvent(new Event('change', { bubbles: true }));
        }
      })
      .catch((error) => {
        console.error('Could not load dependent filter counts', error);
        category.disabled = false;
        source.disabled = false;
        motion.disabled = false;
      });
  })();
</script>
