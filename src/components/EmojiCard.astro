---
import { emojiAssetUrl } from '../lib/emojiAsset';
import { withBase } from '../lib/url';

interface Emoji {
  slug: string;
  name: string;
  shortcode: string;
  emoji: string;
  image: string;
  source: string;
  hexcode: string;
  sourceLabel: string;
  license: string;
  tags: string[];
  group: string;
  category?: string;
  categorySlug?: string;
  format?: string;
  animated: boolean;
}

interface Props {
  emoji: Emoji;
  variant?: 'default' | 'compact';
}

const { emoji, variant = 'default' } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = emojiAssetUrl(emoji, base);
const detailUrl = withBase(`/emoji/${emoji.slug}`, base);
const category = emoji.category || emoji.group.replaceAll('-', ' ');
const categorySlug = emoji.categorySlug || category
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/&/g, 'and')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '') || 'other';
const categoryUrl = withBase(`/categories/${categorySlug}`, base);
const extension = (emoji.format || imageUrl.match(/\.([a-z0-9]+)(?:\?|$)/i)?.[1] || 'png').toLowerCase();
const downloadFilename = `${emoji.slug}.${extension}`;
const searchText = [
  emoji.name,
  emoji.shortcode,
  emoji.sourceLabel,
  emoji.group,
  emoji.category,
  emoji.categorySlug,
  ...emoji.tags
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
const compact = variant === 'compact';
---
<article
  class:list={['emoji-card', { 'emoji-card--compact': compact }]}
  data-emoji-card
  data-card-variant={variant}
  data-search={searchText}
  data-source={emoji.sourceLabel.toLowerCase()}
  data-source-label={emoji.sourceLabel}
  data-group={emoji.group}
  data-category={category}
  data-category-slug={categorySlug}
  data-animated={emoji.animated ? 'yes' : 'no'}
  data-download-key={emoji.slug}
  data-download-name={emoji.name}
  data-download-url={imageUrl}
  data-download-filename={downloadFilename}
  data-favorite-key={emoji.slug}
  data-favorite-name={emoji.name}
  data-favorite-image={imageUrl}
  data-favorite-category={category}
  data-favorite-category-slug={categorySlug}
  data-favorite-source={emoji.sourceLabel}
  data-favorite-format={extension}
  data-favorite-animated={emoji.animated ? 'yes' : 'no'}
  data-favorite-emoji={emoji.emoji}
  data-favorite-shortcode={emoji.shortcode}
>
  {!compact && (
    <>
      <label class="emoji-select-control !grid" data-beui-tooltip={`Select ${emoji.name}`}>
        <input type="checkbox" data-emoji-select aria-label={`Select ${emoji.name}`} />
        <span aria-hidden="true">✓</span>
      </label>

      <button
        class="emoji-card-favorite"
        type="button"
        data-favorite-action
        data-beui-tooltip={`Save ${emoji.name} to My Emoji`}
        aria-label={`Save ${emoji.name} to My Emoji`}
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <a
        class="emoji-card-download"
        href={imageUrl}
        download={downloadFilename}
        data-beui-tooltip={`Download ${emoji.name}`}
        aria-label={`Download ${emoji.name}`}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4v10m0 0 4-4m-4 4-4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </>
  )}

  <a class="emoji-preview is-image-loading" href={detailUrl} data-quick-view-trigger aria-label={`Quick view ${emoji.name}`}>
    <img src={imageUrl} alt={emoji.name} loading={compact ? 'eager' : 'lazy'} width="128" height="128" />
    {emoji.animated && <span class="card-motion-badge">GIF</span>}
  </a>

  <div class="emoji-card-body">
    <div class="emoji-title-row">
      <a class="emoji-name" href={detailUrl}>{emoji.name}</a>
      {!compact && <span class="native-emoji" aria-hidden="true">{emoji.emoji}</span>}
    </div>

    <a class="emoji-category" href={categoryUrl} data-beui-tooltip={`Browse ${category}`}>{category}</a>

    {!compact && (
      <div class="emoji-meta">
        <span>{emoji.sourceLabel}</span>
        <span>{emoji.animated ? 'Animated' : (emoji.format || 'Static').toUpperCase()}</span>
      </div>
    )}
  </div>
</article>

<script>
  import '../scripts/emoji-card-client.js';
</script>
