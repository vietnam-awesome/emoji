---
import EmojiShareDialog from './EmojiShareDialog.astro';
import { emojiAssetUrl } from '../../lib/emojiAsset';
import { emojiCategorySlug } from '../../lib/category';
import { withBase } from '../../lib/url';

const { emoji } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = emojiAssetUrl(emoji, base);
const browseUrl = withBase('/emojis', base);
const editorBaseUrl = withBase('/editor', base);
const editorUrl = `${editorBaseUrl}?src=${encodeURIComponent(imageUrl)}&name=${encodeURIComponent(emoji.name)}${emoji.animated ? '&animated=1' : ''}`;
const isAnimatedGif = Boolean(emoji.animated && String(emoji.format || '').toLowerCase() === 'gif');
const category = emoji.category || String(emoji.group || '').replaceAll('-', ' ');
const categorySlug = emojiCategorySlug(emoji);
const categoryUrl = withBase(`/categories/${categorySlug}`, base);
const normalizeIdentity = (value) => String(value || '')
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '');
const hasDistinctShortcode = Boolean(
  emoji.shortcode && normalizeIdentity(emoji.shortcode) !== normalizeIdentity(emoji.name)
);
const tagTargetUrl = (tag) => {
  const tagIdentity = normalizeIdentity(tag);
  if (tagIdentity === 'animated') return `${browseUrl}?motion=yes`;
  const sourceIdentity = normalizeIdentity(emoji.source);
  const sourceLabelIdentity = normalizeIdentity(emoji.sourceLabel);
  if (emoji.source && tagIdentity && (tagIdentity === sourceIdentity || tagIdentity === sourceLabelIdentity)) {
    return `${browseUrl}?source=${encodeURIComponent(String(emoji.source).toLowerCase())}`;
  }
  if (tagIdentity && (tagIdentity === normalizeIdentity(category) || tagIdentity === normalizeIdentity(categorySlug))) {
    return categoryUrl;
  }
  return `${browseUrl}?q=${encodeURIComponent(tag)}`;
};
---
<section class="shell detail-page">
  <div class="detail-grid">
    <aside class="detail-preview" aria-label={`${emoji.name} preview`}>
      <div class="detail-preview-head">
        <span>Preview</span>
        <span id="detail-preview-size">Original size</span>
      </div>
      <button
        class="detail-preview-image-button"
        type="button"
        aria-controls="detail-lightbox"
        aria-haspopup="dialog"
        aria-label={`Zoom ${emoji.name}`}
        data-detail-open-zoom
        data-beui-tooltip={`Zoom ${emoji.name}`}
      >
        <span class="detail-preview-canvas is-image-loading">
          <img id="detail-preview-image" src={imageUrl} alt={emoji.name} />
        </span>
      </button>
      <div class="detail-preview-actions" aria-label="Preview actions">
        <button
          class="secondary-action detail-preview-action"
          id="detail-preview-zoom"
          type="button"
          aria-controls="detail-lightbox"
          aria-haspopup="dialog"
          data-detail-open-zoom
        >
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="m21 21-4.3-4.3m2.3-5.7a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-11 0h6m-3-3v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Zoom preview
        </button>
        <a class="primary-action detail-preview-action" href={editorUrl}>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 20h4l11-11-4-4L4 16v4Zm9-13 4 4M14 6l2-2 4 4-2 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {isAnimatedGif ? 'Edit GIF' : emoji.animated ? 'Edit static frame' : 'Edit emoji'}
        </a>
      </div>
    </aside>

    <div class="detail-content">
      <div class="detail-title-row">
        <div>
          <p class="eyebrow">{emoji.sourceLabel}</p>
          <h1>{emoji.name}</h1>
        </div>
        {emoji.emoji && <span class="detail-native" aria-hidden="true">{emoji.emoji}</span>}
      </div>

      {hasDistinctShortcode && (
        <button class="copy-large" type="button" data-copy={`:${emoji.shortcode}:`}>
          <span>:{emoji.shortcode}:</span>
          <strong>Copy shortcode</strong>
        </button>
      )}

      <div class:list={['tag-list', { 'without-shortcode': !hasDistinctShortcode }]} aria-label="Related emoji tags">
        {(emoji.tags || []).slice(0, 12).map((tag) => (
          <a href={tagTargetUrl(tag)} data-beui-tooltip={`Browse emoji related to ${tag}`}>{tag}</a>
        ))}
      </div>

      <div class="detail-actions">
        <a class="primary-action" href={imageUrl} download>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 4v10m0 0 4-4m-4 4-4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Download {String(emoji.format || '').toUpperCase()}
        </a>
        <button
          class="secondary-action detail-favorite-action"
          type="button"
          data-favorite-action
          data-beui-tooltip={`Save ${emoji.name} to My Emoji`}
          aria-label={`Save ${emoji.name} to My Emoji`}
          data-favorite-key={emoji.slug}
          data-favorite-name={emoji.name}
          data-favorite-image={imageUrl}
          data-favorite-category={category}
          data-favorite-category-slug={categorySlug}
          data-favorite-source={emoji.sourceLabel}
          data-favorite-format={emoji.format || ''}
          data-favorite-animated={emoji.animated ? 'yes' : 'no'}
          data-favorite-emoji={emoji.emoji || ''}
          data-favorite-shortcode={emoji.shortcode || ''}
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="sr-only" data-favorite-label>Save to My Emoji</span>
        </button>
        <EmojiShareDialog emoji={emoji} imageUrl={imageUrl} />
      </div>

      <dl class="metadata-list">
        <div><dt>Category</dt><dd><a href={categoryUrl}>{category}</a></dd></div>
        {hasDistinctShortcode && <div><dt>Shortcode</dt><dd>:{emoji.shortcode}:</dd></div>}
        {emoji.collection && <div><dt>Collection</dt><dd>{emoji.collection}</dd></div>}
        {emoji.style && <div><dt>Style</dt><dd>{emoji.style}</dd></div>}
        <div><dt>Source</dt><dd>{emoji.sourceLabel}</dd></div>
        <div><dt>Format</dt><dd>{String(emoji.format || '').toUpperCase()}{emoji.animated ? ' · Animated' : ''}</dd></div>
        {emoji.hexcode && <div><dt>Hexcode</dt><dd>{emoji.hexcode}</dd></div>}
        <div><dt>License</dt><dd>{emoji.license}</dd></div>
        <div><dt>Attribution</dt><dd>{emoji.attribution}</dd></div>
      </dl>
    </div>
  </div>

  <section
    class="detail-similar"
    aria-labelledby="similar-emoji-title"
    data-similar-section
    data-current-slug={emoji.slug}
    data-current-name={emoji.name}
    data-current-shortcode={emoji.shortcode || ''}
    data-current-group={emoji.group || ''}
    data-current-category={categorySlug}
    data-current-source={emoji.source || ''}
    data-current-format={emoji.format || ''}
    data-current-animated={emoji.animated ? 'yes' : 'no'}
    data-current-hexcode={emoji.hexcode || ''}
    data-current-collection={emoji.collection || ''}
    data-current-style={emoji.style || ''}
    data-current-tags={JSON.stringify((emoji.tags || []).slice(0, 16))}
    data-current-topics={JSON.stringify((emoji.topics || []).slice(0, 12))}
    data-search-root={withBase('/search', base).replace(/\/$/, '')}
    hidden
  >
    <div class="section-heading-modern">
      <div>
        <p class="section-kicker">Discovery</p>
        <h2 id="similar-emoji-title">Similar emoji</h2>
        <p>Related by Unicode identity, category, tags, collection and style.</p>
      </div>
      <a href={categoryUrl}>More in {category} <span>→</span></a>
    </div>
    <div class="detail-similar-grid" data-similar-grid>
      {Array.from({ length: 6 }).map(() => (
        <div class="detail-client-card-skeleton" aria-hidden="true">
          <span class="detail-client-card-skeleton-media"></span>
          <span class="detail-client-card-skeleton-line detail-client-card-skeleton-line--title"></span>
          <span class="detail-client-card-skeleton-line detail-client-card-skeleton-line--meta"></span>
        </div>
      ))}
    </div>
  </section>

  <section
    class="detail-random"
    aria-labelledby="random-emoji-title"
    data-random-section
    data-current-slug={emoji.slug}
    data-search-root={withBase('/search', base).replace(/\/$/, '')}
    hidden
  >
    <div class="section-heading-modern">
      <div>
        <p class="section-kicker">Explore</p>
        <h2 id="random-emoji-title">Random emoji</h2>
        <p>A fresh mix from across the library.</p>
      </div>
      <button class="detail-random-shuffle" type="button" data-random-shuffle data-beui-tooltip="Shuffle random emoji" aria-label="Shuffle random emoji">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3h5v5M4 20l6.5-6.5M21 16v5h-5M14.5 10.5 21 4M4 4l16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="detail-random-grid" data-random-grid>
      {Array.from({ length: 6 }).map(() => (
        <div class="detail-client-card-skeleton" aria-hidden="true">
          <span class="detail-client-card-skeleton-media"></span>
          <span class="detail-client-card-skeleton-line detail-client-card-skeleton-line--title"></span>
          <span class="detail-client-card-skeleton-line detail-client-card-skeleton-line--meta"></span>
        </div>
      ))}
    </div>
  </section>
</section>

<dialog class="detail-lightbox" id="detail-lightbox" aria-label={`Preview ${emoji.name}`}>
  <div class="detail-lightbox-shell">
    <div class="detail-lightbox-toolbar">
      <span id="detail-lightbox-size">Original size</span>
      <div class="detail-lightbox-zoom-levels" role="group" aria-label="Zoom level">
        <button type="button" data-detail-zoom="fit" aria-pressed="false">Fit</button>
        <button type="button" data-detail-zoom="1" class="is-active" aria-pressed="true">1×</button>
        <button type="button" data-detail-zoom="2" aria-pressed="false">2×</button>
        <button type="button" data-detail-zoom="4" aria-pressed="false">4×</button>
      </div>
      <button class="detail-lightbox-close" id="detail-lightbox-close" type="button" aria-label="Close preview">×</button>
    </div>
    <div class="detail-lightbox-stage is-image-loading">
      <img id="detail-lightbox-image" src={imageUrl} alt={emoji.name} />
    </div>
  </div>
</dialog>

<script>
  document.addEventListener('click', async (event) => {
    const target = event.target;
    const button = target instanceof Element ? target.closest('[data-copy]') : null;
    if (!(button instanceof HTMLButtonElement)) return;
    await navigator.clipboard.writeText(button.dataset.copy || '');
    const label = button.querySelector('strong');
    if (!label) return;
    const previous = label.textContent;
    label.textContent = 'Copied!';
    window.setTimeout(() => { label.textContent = previous; }, 900);
  });

  const previewZoomButtons = [...document.querySelectorAll('[data-detail-open-zoom]')];
  const previewImage = document.querySelector('#detail-preview-image');
  const previewCanvas = previewImage?.closest('.detail-preview-canvas');
  const previewSize = document.querySelector('#detail-preview-size');
  const lightbox = document.querySelector('#detail-lightbox');
  const lightboxImage = document.querySelector('#detail-lightbox-image');
  const lightboxStage = lightboxImage?.closest('.detail-lightbox-stage');
  const lightboxSize = document.querySelector('#detail-lightbox-size');
  const lightboxClose = document.querySelector('#detail-lightbox-close');
  const zoomButtons = [...document.querySelectorAll('[data-detail-zoom]')];

  const settleImageSkeleton = (image, container) => {
    if (!(image instanceof HTMLImageElement) || !(container instanceof Element)) return;
    const settle = () => container.classList.remove('is-image-loading');
    if (image.complete) queueMicrotask(settle);
    else {
      image.addEventListener('load', settle, { once: true });
      image.addEventListener('error', settle, { once: true });
    }
  };

  settleImageSkeleton(previewImage, previewCanvas);
  settleImageSkeleton(lightboxImage, lightboxStage);

  const syncOriginalSize = () => {
    const sourceImage = lightboxImage instanceof HTMLImageElement ? lightboxImage : previewImage;
    if (!(sourceImage instanceof HTMLImageElement)) return;
    const width = sourceImage.naturalWidth || (previewImage instanceof HTMLImageElement ? previewImage.naturalWidth : 0);
    const height = sourceImage.naturalHeight || (previewImage instanceof HTMLImageElement ? previewImage.naturalHeight : 0);
    if (!width || !height) return;
    const label = `Original ${width}×${height}px`;
    if (previewSize) previewSize.textContent = label;
    if (lightboxSize) lightboxSize.textContent = label;
  };

  const setZoom = (value) => {
    if (!(lightboxImage instanceof HTMLImageElement)) return;
    const naturalWidth = lightboxImage.naturalWidth || 1;
    const naturalHeight = lightboxImage.naturalHeight || 1;
    if (value === 'fit') {
      lightboxImage.style.width = 'auto';
      lightboxImage.style.height = 'auto';
      lightboxImage.style.maxWidth = '100%';
      lightboxImage.style.maxHeight = '100%';
    } else {
      const level = Math.max(1, Number(value) || 1);
      lightboxImage.style.width = `${naturalWidth * level}px`;
      lightboxImage.style.height = `${naturalHeight * level}px`;
      lightboxImage.style.maxWidth = 'none';
      lightboxImage.style.maxHeight = 'none';
    }
    for (const button of zoomButtons) {
      if (!(button instanceof HTMLButtonElement)) continue;
      const active = button.dataset.detailZoom === String(value);
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    }
  };

  if (previewImage instanceof HTMLImageElement) {
    if (previewImage.complete) syncOriginalSize();
    else previewImage.addEventListener('load', syncOriginalSize, { once: true });
  }
  if (lightboxImage instanceof HTMLImageElement) {
    if (lightboxImage.complete) syncOriginalSize();
    else lightboxImage.addEventListener('load', syncOriginalSize, { once: true });
  }

  for (const button of previewZoomButtons) {
    button.addEventListener('click', () => {
      if (!(lightbox instanceof HTMLDialogElement)) return;
      syncOriginalSize();
      setZoom('1');
      lightbox.showModal();
    });
  }
  for (const button of zoomButtons) {
    button.addEventListener('click', () => {
      if (button instanceof HTMLButtonElement) setZoom(button.dataset.detailZoom || '1');
    });
  }
  lightboxClose?.addEventListener('click', () => {
    if (lightbox instanceof HTMLDialogElement) lightbox.close();
  });
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox && lightbox instanceof HTMLDialogElement) lightbox.close();
  });

  const similarSection = document.querySelector('[data-similar-section]');
  const similarGrid = similarSection?.querySelector('[data-similar-grid]');

  const normalizeSimilar = (value) => String(value || '')
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();

  const compactSimilar = (value) => normalizeSimilar(value).replace(/\s+/g, '');

  const safeJsonArray = (value) => {
    try {
      const parsed = JSON.parse(value || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  const sharedSimilarCount = (left, right) => {
    const rightSet = new Set((right || []).map(normalizeSimilar).filter(Boolean));
    let count = 0;
    for (const value of new Set((left || []).map(normalizeSimilar).filter(Boolean))) {
      if (rightSet.has(value)) count += 1;
    }
    return count;
  };

  const similarWordSet = (record) => new Set(
    normalizeSimilar([record?.name, record?.shortcode].filter(Boolean).join(' '))
      .split(/\s+/)
      .filter((word) => word.length > 1)
  );

  const matchesSimilar = (left, right) => {
    const a = compactSimilar(left);
    const b = compactSimilar(right);
    return Boolean(a && b && a === b);
  };

  const scoreSimilar = (target, candidate) => {
    if (!candidate || candidate.slug === target.slug) return Number.NEGATIVE_INFINITY;
    let score = 0;
    if (matchesSimilar(target.hexcode, candidate.hexcode)) score += 36;
    if (matchesSimilar(target.category, candidate.categorySlug || candidate.category)) score += 14;
    if (matchesSimilar(target.group, candidate.group)) score += 7;
    if (matchesSimilar(target.collection, candidate.collection)) score += 5;
    if (matchesSimilar(target.style, candidate.style)) score += 3;
    if (matchesSimilar(target.shortcode, candidate.shortcode)) score += 8;
    score += Math.min(sharedSimilarCount(target.tags, candidate.tags) * 5, 20);
    score += Math.min(sharedSimilarCount(target.topics, candidate.topics) * 3, 9);

    const targetWords = similarWordSet(target);
    const candidateWords = similarWordSet(candidate);
    let sharedWords = 0;
    for (const word of targetWords) if (candidateWords.has(word)) sharedWords += 1;
    score += Math.min(sharedWords * 2, 6);

    if (matchesSimilar(target.source, candidate.source)) score += 1;
    if (Boolean(target.animated) === Boolean(candidate.animated)) score += 1;
    if (matchesSimilar(target.format, candidate.format)) score += 0.5;
    return score;
  };

  const expandSimilarRecord = (row) => ({
    slug: row.s,
    name: row.n,
    shortcode: row.c,
    group: row.g,
    category: row.ca,
    categorySlug: row.cs,
    tags: row.t || [],
    source: row.src,
    sourceLabel: row.sl,
    image: row.i,
    format: row.f,
    animated: Boolean(row.a),
    emoji: row.e || '',
    hexcode: row.h,
    collection: row.co,
    style: row.st,
    topics: row.tp || []
  });

  const createSimilarCard = (emoji) => {
    const basePrefix = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
    const detailUrl = `${basePrefix}/emoji/${encodeURIComponent(emoji.slug)}`;
    const categorySlugValue = emoji.categorySlug || 'other';
    const categoryUrlValue = `${basePrefix}/categories/${encodeURIComponent(categorySlugValue)}`;

    const article = document.createElement('article');
    article.className = 'emoji-card';
    article.dataset.emojiCard = '';
    article.dataset.category = emoji.category || emoji.group || 'Other';
    article.dataset.categorySlug = categorySlugValue;
    article.dataset.sourceLabel = emoji.sourceLabel || '';
    article.dataset.downloadKey = emoji.slug;
    article.dataset.downloadName = emoji.name;
    article.dataset.downloadUrl = emoji.image;

    const preview = document.createElement('a');
    preview.className = 'emoji-preview is-image-loading';
    preview.href = detailUrl;
    preview.setAttribute('aria-label', `Open ${emoji.name}`);

    const image = document.createElement('img');
    image.alt = emoji.name;
    image.loading = 'lazy';
    image.width = 128;
    image.height = 128;

    // Client-rendered cards settle their own image skeleton so a cached image
    // cannot finish before the shared MutationObserver attaches its listeners.
    const settlePreview = () => preview.classList.remove('is-image-loading');
    image.addEventListener('load', settlePreview, { once: true });
    image.addEventListener('error', settlePreview, { once: true });
    image.src = emoji.image;
    preview.append(image);
    if (image.complete) queueMicrotask(settlePreview);

    if (emoji.animated) {
      const badge = document.createElement('span');
      badge.className = 'card-motion-badge';
      badge.textContent = 'GIF';
      preview.append(badge);
    }

    const body = document.createElement('div');
    body.className = 'emoji-card-body';

    const titleRow = document.createElement('div');
    titleRow.className = 'emoji-title-row';
    const name = document.createElement('a');
    name.className = 'emoji-name';
    name.href = detailUrl;
    name.textContent = emoji.name;
    const nativeEmoji = document.createElement('span');
    nativeEmoji.className = 'native-emoji';
    nativeEmoji.setAttribute('aria-hidden', 'true');
    nativeEmoji.textContent = emoji.emoji || '';
    titleRow.append(name, nativeEmoji);

    const categoryLink = document.createElement('a');
    categoryLink.className = 'emoji-category';
    categoryLink.href = categoryUrlValue;
    categoryLink.textContent = emoji.category || emoji.group || 'Other';

    const meta = document.createElement('div');
    meta.className = 'emoji-meta';
    const source = document.createElement('span');
    source.textContent = emoji.sourceLabel || '';
    const format = document.createElement('span');
    format.textContent = emoji.animated ? 'Animated' : String(emoji.format || 'Static').toUpperCase();
    meta.append(source, format);

    body.append(titleRow, categoryLink, meta);
    article.append(preview, body);
    return article;
  };

  const loadSimilarEmoji = async () => {
    if (!(similarSection instanceof HTMLElement) || !(similarGrid instanceof HTMLElement)) return;

    const searchRoot = similarSection.dataset.searchRoot || '/search';
    const target = {
      slug: similarSection.dataset.currentSlug || '',
      name: similarSection.dataset.currentName || '',
      shortcode: similarSection.dataset.currentShortcode || '',
      group: similarSection.dataset.currentGroup || '',
      category: similarSection.dataset.currentCategory || '',
      source: similarSection.dataset.currentSource || '',
      format: similarSection.dataset.currentFormat || '',
      animated: similarSection.dataset.currentAnimated === 'yes',
      hexcode: similarSection.dataset.currentHexcode || '',
      collection: similarSection.dataset.currentCollection || '',
      style: similarSection.dataset.currentStyle || '',
      tags: safeJsonArray(similarSection.dataset.currentTags),
      topics: safeJsonArray(similarSection.dataset.currentTopics)
    };

    try {
      const manifestResponse = await fetch(`${searchRoot}/manifest.json`);
      if (!manifestResponse.ok) return;
      const manifest = await manifestResponse.json();
      const categoryEntry = manifest.categories?.find((entry) => entry.value === target.category);
      if (!categoryEntry) return;

      const idsResponse = await fetch(`${searchRoot}/facets/category/${categoryEntry.file}`);
      if (!idsResponse.ok) return;
      const categoryIds = await idsResponse.json();
      if (!Array.isArray(categoryIds) || !categoryIds.length) return;

      const sampleLimit = Math.min(240, categoryIds.length);
      const sampledIds = [];
      const seed = [...target.slug].reduce((hash, char) => (Math.imul(hash ^ char.charCodeAt(0), 16777619) >>> 0), 2166136261);
      const start = categoryIds.length ? seed % categoryIds.length : 0;
      const stride = categoryIds.length / Math.max(1, sampleLimit);
      const seen = new Set();

      for (let index = 0; index < sampleLimit; index += 1) {
        const position = Math.floor((start + index * stride) % categoryIds.length);
        const id = categoryIds[position];
        if (seen.has(id)) continue;
        seen.add(id);
        sampledIds.push(id);
      }

      const chunkIndexes = [...new Set(sampledIds.map((id) => Math.floor(id / manifest.chunkSize)))];
      const chunks = new Map();
      await Promise.all(chunkIndexes.map(async (chunkIndex) => {
        const response = await fetch(`${searchRoot}/chunks/${String(chunkIndex).padStart(4, '0')}.json`);
        if (!response.ok) return;
        chunks.set(chunkIndex, await response.json());
      }));

      const candidates = sampledIds
        .map((id) => {
          const chunkIndex = Math.floor(id / manifest.chunkSize);
          const row = chunks.get(chunkIndex)?.[id % manifest.chunkSize];
          return row ? expandSimilarRecord(row) : null;
        })
        .filter(Boolean)
        .map((record) => ({ record, score: scoreSimilar(target, record) }))
        .filter(({ score }) => Number.isFinite(score) && score > 0)
        .sort((left, right) => right.score - left.score || left.record.name.localeCompare(right.record.name))
        .slice(0, 12)
        .map(({ record }) => record);

      if (!candidates.length) { similarSection.hidden = true; return; }
      const fragment = document.createDocumentFragment();
      for (const record of candidates) fragment.append(createSimilarCard(record));
      similarGrid.replaceChildren(fragment);
      similarSection.hidden = false;
    } catch (error) {
      similarSection.hidden = true;
      console.warn('Could not load similar emoji', error);
    }
  };

  loadSimilarEmoji();

  const randomSection = document.querySelector('[data-random-section]');
  const randomGrid = document.querySelector('[data-random-grid]');
  const randomShuffle = document.querySelector('[data-random-shuffle]');
  let randomItems = [];

  const shuffleRandomEmoji = () => {
    if (!randomItems.length || !randomGrid) return;
    const shuffled = [...randomItems];
    for (let index = shuffled.length - 1; index > 0; index -= 1) {
      const swapIndex = Math.floor(Math.random() * (index + 1));
      [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
    }
    const visible = new Set(shuffled.slice(0, Math.min(6, shuffled.length)));
    for (const item of randomItems) {
      if (item instanceof HTMLElement) item.hidden = !visible.has(item);
    }
    for (const item of shuffled) randomGrid.append(item);
  };

  const loadRandomEmoji = async () => {
    if (!(randomSection instanceof HTMLElement) || !(randomGrid instanceof HTMLElement)) return;

    const searchRoot = randomSection.dataset.searchRoot || '/search';
    const currentSlug = randomSection.dataset.currentSlug || '';

    try {
      const manifestResponse = await fetch(`${searchRoot}/manifest.json`);
      if (!manifestResponse.ok) return;
      const manifest = await manifestResponse.json();
      const total = Math.max(0, Number(manifest.total) || 0);
      const chunkSize = Math.max(1, Number(manifest.chunkSize) || 1000);
      if (total < 2) return;

      const ids = [];
      const seen = new Set();
      const targetCount = Math.min(24, total - 1);
      const maxAttempts = Math.max(targetCount * 8, 64);

      for (let attempt = 0; ids.length < targetCount && attempt < maxAttempts; attempt += 1) {
        const id = Math.floor(Math.random() * total);
        if (seen.has(id)) continue;
        seen.add(id);
        ids.push(id);
      }

      const chunkIndexes = [...new Set(ids.map((id) => Math.floor(id / chunkSize)))];
      const chunks = new Map();
      await Promise.all(chunkIndexes.map(async (chunkIndex) => {
        const response = await fetch(`${searchRoot}/chunks/${String(chunkIndex).padStart(4, '0')}.json`);
        if (!response.ok) return;
        chunks.set(chunkIndex, await response.json());
      }));

      const records = ids
        .map((id) => {
          const chunkIndex = Math.floor(id / chunkSize);
          const row = chunks.get(chunkIndex)?.[id % chunkSize];
          return row ? expandSimilarRecord(row) : null;
        })
        .filter((record) => record && record.slug !== currentSlug)
        .slice(0, 24);

      if (!records.length) { randomSection.hidden = true; return; }

      const fragment = document.createDocumentFragment();
      randomItems = records.map((record) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'detail-random-item';
        wrapper.dataset.randomItem = '';
        wrapper.append(createSimilarCard(record));
        fragment.append(wrapper);
        return wrapper;
      });

      randomGrid.replaceChildren(fragment);
      randomSection.hidden = false;
      shuffleRandomEmoji();
    } catch (error) {
      randomSection.hidden = true;
      console.warn('Could not load random emoji', error);
    }
  };

  randomShuffle?.addEventListener('click', shuffleRandomEmoji);
  loadRandomEmoji();
</script>

