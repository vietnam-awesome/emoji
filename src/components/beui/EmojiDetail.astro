---
import { emojiAssetUrl } from '../../lib/emojiAsset';
import { emojiCategorySlug } from '../../lib/category';
import { withBase } from '../../lib/url';

const { emoji } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = emojiAssetUrl(emoji, base);
const browseUrl = withBase('/emojis', base);
const category = emoji.category || String(emoji.group || '').replaceAll('-', ' ');
const categorySlug = emojiCategorySlug(emoji);
const categoryUrl = withBase(`/categories/${categorySlug}`, base);
const normalizeIdentity = (value) => String(value || '')
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '');
const hasDistinctShortcode = Boolean(
  emoji.shortcode && normalizeIdentity(emoji.shortcode) !== normalizeIdentity(emoji.name)
);
const tagTargetUrl = (tag) => {
  const tagIdentity = normalizeIdentity(tag);
  if (tagIdentity === 'animated') return `${browseUrl}?motion=yes`;
  const sourceIdentity = normalizeIdentity(emoji.source);
  const sourceLabelIdentity = normalizeIdentity(emoji.sourceLabel);
  if (emoji.source && tagIdentity && (tagIdentity === sourceIdentity || tagIdentity === sourceLabelIdentity)) {
    return `${browseUrl}?source=${encodeURIComponent(String(emoji.source).toLowerCase())}`;
  }
  if (tagIdentity && (tagIdentity === normalizeIdentity(category) || tagIdentity === normalizeIdentity(categorySlug))) {
    return categoryUrl;
  }
  return `${browseUrl}?q=${encodeURIComponent(tag)}`;
};
---
<section class="shell detail-page">
  <div class="detail-grid">
    <aside class="detail-preview" aria-label={`${emoji.name} preview`}>
      <div class="detail-preview-head">
        <span>Preview</span>
        <span id="detail-preview-size">Original size</span>
      </div>
      <button
        class="detail-preview-image-button"
        id="detail-preview-zoom"
        type="button"
        aria-controls="detail-lightbox"
        aria-haspopup="dialog"
        title={`Zoom ${emoji.name}`}
      >
        <span class="detail-preview-canvas">
          <img id="detail-preview-image" src={imageUrl} alt={emoji.name} />
        </span>
        <span class="detail-preview-zoom-hint" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m21 21-4.3-4.3m2.3-5.7a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-11 0h6m-3-3v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Open zoom preview
        </span>
      </button>
    </aside>

    <div class="detail-content">
      <div class="detail-title-row">
        <div>
          <p class="eyebrow">{emoji.sourceLabel}</p>
          <h1>{emoji.name}</h1>
        </div>
        {emoji.emoji && <span class="detail-native" aria-hidden="true">{emoji.emoji}</span>}
      </div>

      {hasDistinctShortcode && (
        <button class="copy-large" type="button" data-copy={`:${emoji.shortcode}:`}>
          <span>:{emoji.shortcode}:</span>
          <strong>Copy shortcode</strong>
        </button>
      )}

      <div class:list={['tag-list', { 'without-shortcode': !hasDistinctShortcode }]} aria-label="Related emoji tags">
        {(emoji.tags || []).slice(0, 12).map((tag) => (
          <a href={tagTargetUrl(tag)} title={`Browse emoji related to ${tag}`}>{tag}</a>
        ))}
      </div>

      <div class="detail-actions">
        <a class="primary-action" href={imageUrl} download>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 4v10m0 0 4-4m-4 4-4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Download {String(emoji.format || '').toUpperCase()}
        </a>
        {emoji.sourceUrl && (
          <a class="secondary-action" href={emoji.sourceUrl} rel="noreferrer">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M14 5h5v5m0-5-8 8M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            View original source
          </a>
        )}
      </div>

      <dl class="metadata-list">
        <div><dt>Category</dt><dd><a href={categoryUrl}>{category}</a></dd></div>
        {hasDistinctShortcode && <div><dt>Shortcode</dt><dd>:{emoji.shortcode}:</dd></div>}
        {emoji.collection && <div><dt>Collection</dt><dd>{emoji.collection}</dd></div>}
        {emoji.style && <div><dt>Style</dt><dd>{emoji.style}</dd></div>}
        <div><dt>Source</dt><dd>{emoji.sourceLabel}</dd></div>
        <div><dt>Format</dt><dd>{String(emoji.format || '').toUpperCase()}{emoji.animated ? ' · Animated' : ''}</dd></div>
        {emoji.hexcode && <div><dt>Hexcode</dt><dd>{emoji.hexcode}</dd></div>}
        <div><dt>License</dt><dd>{emoji.license}</dd></div>
        <div><dt>Attribution</dt><dd>{emoji.attribution}</dd></div>
      </dl>
    </div>
  </div>
</section>

<dialog class="detail-lightbox" id="detail-lightbox" aria-label={`Preview ${emoji.name}`}>
  <div class="detail-lightbox-shell">
    <div class="detail-lightbox-toolbar">
      <span id="detail-lightbox-size">Original size</span>
      <div class="detail-lightbox-zoom-levels" role="group" aria-label="Zoom level">
        <button type="button" data-detail-zoom="fit">Fit</button>
        <button type="button" data-detail-zoom="1" class="is-active">1×</button>
        <button type="button" data-detail-zoom="2">2×</button>
        <button type="button" data-detail-zoom="4">4×</button>
      </div>
      <button class="detail-lightbox-close" id="detail-lightbox-close" type="button" aria-label="Close preview">×</button>
    </div>
    <div class="detail-lightbox-stage">
      <img id="detail-lightbox-image" src={imageUrl} alt={emoji.name} />
    </div>
  </div>
</dialog>

<script>
  document.addEventListener('click', async (event) => {
    const target = event.target;
    const button = target instanceof Element ? target.closest('[data-copy]') : null;
    if (!(button instanceof HTMLButtonElement)) return;
    await navigator.clipboard.writeText(button.dataset.copy || '');
    const label = button.querySelector('strong');
    if (!label) return;
    const previous = label.textContent;
    label.textContent = 'Copied!';
    window.setTimeout(() => { label.textContent = previous; }, 900);
  });

  const previewZoomButton = document.querySelector('#detail-preview-zoom');
  const previewImage = document.querySelector('#detail-preview-image');
  const previewSize = document.querySelector('#detail-preview-size');
  const lightbox = document.querySelector('#detail-lightbox');
  const lightboxImage = document.querySelector('#detail-lightbox-image');
  const lightboxSize = document.querySelector('#detail-lightbox-size');
  const lightboxClose = document.querySelector('#detail-lightbox-close');
  const zoomButtons = [...document.querySelectorAll('[data-detail-zoom]')];

  const syncOriginalSize = () => {
    const sourceImage = lightboxImage instanceof HTMLImageElement ? lightboxImage : previewImage;
    if (!(sourceImage instanceof HTMLImageElement)) return;
    const width = sourceImage.naturalWidth || (previewImage instanceof HTMLImageElement ? previewImage.naturalWidth : 0);
    const height = sourceImage.naturalHeight || (previewImage instanceof HTMLImageElement ? previewImage.naturalHeight : 0);
    if (!width || !height) return;
    const label = `Original ${width}×${height}px`;
    if (previewSize) previewSize.textContent = label;
    if (lightboxSize) lightboxSize.textContent = label;
  };

  const setZoom = (value) => {
    if (!(lightboxImage instanceof HTMLImageElement)) return;
    const naturalWidth = lightboxImage.naturalWidth || 1;
    const naturalHeight = lightboxImage.naturalHeight || 1;
    if (value === 'fit') {
      lightboxImage.style.width = 'auto';
      lightboxImage.style.height = 'auto';
      lightboxImage.style.maxWidth = '100%';
      lightboxImage.style.maxHeight = '100%';
    } else {
      const level = Math.max(1, Number(value) || 1);
      lightboxImage.style.width = `${naturalWidth * level}px`;
      lightboxImage.style.height = `${naturalHeight * level}px`;
      lightboxImage.style.maxWidth = 'none';
      lightboxImage.style.maxHeight = 'none';
    }
    for (const button of zoomButtons) {
      if (button instanceof HTMLButtonElement) button.classList.toggle('is-active', button.dataset.detailZoom === String(value));
    }
  };

  if (previewImage instanceof HTMLImageElement) {
    if (previewImage.complete) syncOriginalSize();
    else previewImage.addEventListener('load', syncOriginalSize, { once: true });
  }
  if (lightboxImage instanceof HTMLImageElement) {
    if (lightboxImage.complete) syncOriginalSize();
    else lightboxImage.addEventListener('load', syncOriginalSize, { once: true });
  }

  previewZoomButton?.addEventListener('click', () => {
    if (!(lightbox instanceof HTMLDialogElement)) return;
    syncOriginalSize();
    setZoom('1');
    lightbox.showModal();
  });
  for (const button of zoomButtons) {
    button.addEventListener('click', () => {
      if (button instanceof HTMLButtonElement) setZoom(button.dataset.detailZoom || '1');
    });
  }
  lightboxClose?.addEventListener('click', () => {
    if (lightbox instanceof HTMLDialogElement) lightbox.close();
  });
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox && lightbox instanceof HTMLDialogElement) lightbox.close();
  });
</script>
