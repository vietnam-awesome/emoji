---
---

<div class="cook-skeleton cook-page" aria-hidden="true">
  <header class="cook-skeleton-hero">
    <span class="cook-skeleton-line is-kicker"></span>
    <div class="cook-skeleton-hero-row">
      <div class="cook-skeleton-copy">
        <span class="cook-skeleton-line is-title"></span>
        <span class="cook-skeleton-line is-lead"></span>
        <span class="cook-skeleton-line is-lead-short"></span>
      </div>
      <span class="cook-skeleton-pill is-action"></span>
    </div>
    <div class="cook-skeleton-pills">
      <span class="cook-skeleton-pill"></span>
      <span class="cook-skeleton-pill"></span>
      <span class="cook-skeleton-pill"></span>
      <span class="cook-skeleton-pill"></span>
    </div>
  </header>

  <section class="cook-skeleton-equation">
    <div class="cook-skeleton-equation-card">
      <span class="cook-skeleton-line is-label"></span>
      <span class="cook-skeleton-emoji"></span>
      <span class="cook-skeleton-line is-name"></span>
    </div>
    <span class="cook-skeleton-operator"></span>
    <div class="cook-skeleton-equation-card">
      <span class="cook-skeleton-line is-label"></span>
      <span class="cook-skeleton-emoji"></span>
      <span class="cook-skeleton-line is-name"></span>
    </div>
    <span class="cook-skeleton-operator is-equals"></span>
    <div class="cook-skeleton-result-mini">
      <span class="cook-skeleton-square"></span>
      <span class="cook-skeleton-line is-result-label"></span>
    </div>
    <span class="cook-skeleton-circle"></span>
  </section>

  <div class="cook-skeleton-workspace">
    <section class="cook-skeleton-builder">
      <div class="cook-skeleton-builder-head">
        <div>
          <span class="cook-skeleton-line is-kicker"></span>
          <span class="cook-skeleton-line is-section-title"></span>
        </div>
        <span class="cook-skeleton-pill is-small"></span>
      </div>

      <div class="cook-skeleton-tabs">
        <span></span>
        <span></span>
      </div>

      <span class="cook-skeleton-search"></span>

      <div class="cook-skeleton-category-row">
        <span></span><span></span><span></span><span></span><span></span>
      </div>

      <div class="cook-skeleton-grid-heading">
        <span class="cook-skeleton-line is-count"></span>
        <span class="cook-skeleton-line is-hint"></span>
      </div>

      <div class="cook-skeleton-picker-grid">
        {Array.from({ length: 24 }).map(() => (
          <span class="cook-skeleton-picker-card">
            <i></i>
            <b></b>
          </span>
        ))}
      </div>

      <div class="cook-skeleton-controls">
        <span></span><span></span><span></span>
      </div>

      <div class="cook-skeleton-style-row">
        {Array.from({ length: 7 }).map(() => <span></span>)}
      </div>
    </section>

    <aside class="cook-skeleton-result">
      <div class="cook-skeleton-result-head">
        <div>
          <span class="cook-skeleton-line is-kicker"></span>
          <span class="cook-skeleton-line is-section-title"></span>
        </div>
        <span class="cook-skeleton-pill is-small"></span>
      </div>
      <span class="cook-skeleton-canvas"></span>
      <div class="cook-skeleton-pills">
        <span class="cook-skeleton-pill"></span>
        <span class="cook-skeleton-pill"></span>
        <span class="cook-skeleton-pill"></span>
      </div>
      <div class="cook-skeleton-actions">
        <span></span><span></span><span></span><span></span>
      </div>
      <span class="cook-skeleton-line is-note"></span>
      <span class="cook-skeleton-line is-note-short"></span>
    </aside>
  </div>
</div>

<span class="sr-only" role="status">Loading Emoji Cook…</span>
