---
import Layout from '../../layouts/Layout.astro';
import emojis from '../../data/emojis.json';
import { emojiAssetUrl } from '../../lib/emojiAsset';
import { emojiCategorySlug } from '../../lib/category';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  const fastBuild = process.env.FAST_BUILD === '1';
  const requestedLimit = Number.parseInt(process.env.FAST_BUILD_DETAIL_LIMIT || '300', 10);
  let detailRecords = emojis;

  if (fastBuild && Number.isFinite(requestedLimit) && requestedLimit > 0 && emojis.length > requestedLimit) {
    if (requestedLimit === 1) {
      detailRecords = [emojis[0]];
    } else {
      const sampled = [];
      const seen = new Set();
      for (let index = 0; index < requestedLimit; index += 1) {
        const recordIndex = Math.round((index * (emojis.length - 1)) / (requestedLimit - 1));
        if (seen.has(recordIndex)) continue;
        seen.add(recordIndex);
        sampled.push(emojis[recordIndex]);
      }
      detailRecords = sampled;
    }
  }

  if (fastBuild) {
    console.log(
      `[fast-build] rendering ${detailRecords.length.toLocaleString('en-US')} / ` +
      `${emojis.length.toLocaleString('en-US')} emoji detail pages`
    );
  }

  return detailRecords.map((emoji) => ({
    params: { slug: emoji.slug },
    props: { emoji }
  }));
}

const normalizeIdentity = (value) => String(value || '')
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '');

const { emoji } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = emojiAssetUrl(emoji, base);
const browseUrl = withBase('/emojis', base);
const title = `${emoji.name} — ${emoji.sourceLabel} | ePlus Emoji`;
const category = emoji.category || String(emoji.group || '').replaceAll('-', ' ');
const categorySlug = emojiCategorySlug(emoji);
const categoryUrl = withBase(`/categories/${categorySlug}`, base);
const hasDistinctShortcode = Boolean(
  emoji.shortcode && normalizeIdentity(emoji.shortcode) !== normalizeIdentity(emoji.name)
);
const tagTargetUrl = (tag) => {
  const tagIdentity = normalizeIdentity(tag);
  if (tagIdentity === 'animated') return `${browseUrl}?motion=yes`;

  const sourceIdentity = normalizeIdentity(emoji.source);
  const sourceLabelIdentity = normalizeIdentity(emoji.sourceLabel);
  if (emoji.source && tagIdentity && (tagIdentity === sourceIdentity || tagIdentity === sourceLabelIdentity)) {
    return `${browseUrl}?source=${encodeURIComponent(String(emoji.source).toLowerCase())}`;
  }

  if (tagIdentity && (tagIdentity === normalizeIdentity(category) || tagIdentity === normalizeIdentity(categorySlug))) {
    return categoryUrl;
  }

  return `${browseUrl}?q=${encodeURIComponent(tag)}`;
};
const description = hasDistinctShortcode
  ? `Download ${emoji.name} from ${emoji.sourceLabel}, copy :${emoji.shortcode}: and view source, format and license metadata.`
  : `Download ${emoji.name} from ${emoji.sourceLabel} and view source, format and license metadata.`;
---
<Layout title={title} description={description}>
  <section class="shell detail-page">
    <a class="back-link" href={browseUrl}>← Back to emoji library</a>
    <div class="detail-grid">
      <div class="detail-preview">
        <div class="detail-preview-head" aria-hidden="true">
          <span>Preview</span>
          <span id="detail-preview-size">Original size</span>
        </div>
        <button
          class="detail-preview-image-button"
          id="detail-preview-zoom"
          type="button"
          aria-controls="detail-lightbox"
          aria-haspopup="dialog"
          title={`Zoom ${emoji.name}`}
        >
          <span class="detail-preview-canvas">
            <img id="detail-preview-image" src={imageUrl} alt={emoji.name} />
          </span>
          <span class="detail-preview-zoom-hint" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m21 21-4.3-4.3m2.3-5.7a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-11 0h6m-3-3v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            Open zoom preview
          </span>
        </button>
      </div>

      <div class="detail-content">
        <div class="detail-title-row">
          <div>
            <p class="eyebrow">{emoji.sourceLabel}</p>
            <h1>{emoji.name}</h1>
          </div>
          {emoji.emoji && <span class="detail-native" aria-hidden="true">{emoji.emoji}</span>}
        </div>

        {hasDistinctShortcode && (
          <button class="copy-large" type="button" data-copy={`:${emoji.shortcode}:`}>
            <span>:{emoji.shortcode}:</span>
            <strong>Copy shortcode</strong>
          </button>
        )}

        <div class:list={['tag-list', { 'without-shortcode': !hasDistinctShortcode }]} aria-label="Related emoji tags">
          {(emoji.tags || []).slice(0, 12).map((tag) => (
            <a href={tagTargetUrl(tag)} title={`Browse emoji related to ${tag}`}>{tag}</a>
          ))}
        </div>

        <div class="detail-actions">
          <a class="primary-action" href={imageUrl} download>Download {String(emoji.format || '').toUpperCase()}</a>
          {emoji.sourceUrl && <a class="secondary-action" href={emoji.sourceUrl} rel="noreferrer">View original source</a>}
        </div>

        <dl class="metadata-list" aria-label="Emoji details">
          <div><dt>Category</dt><dd><a href={categoryUrl}>{category}</a></dd></div>
          {hasDistinctShortcode && <div><dt>Shortcode</dt><dd>:{emoji.shortcode}:</dd></div>}
          {emoji.collection && <div><dt>Collection</dt><dd>{emoji.collection}</dd></div>}
          {emoji.style && <div><dt>Style</dt><dd>{emoji.style}</dd></div>}
          <div><dt>Source</dt><dd>{emoji.sourceLabel}</dd></div>
          <div><dt>Format</dt><dd>{String(emoji.format || '').toUpperCase()}{emoji.animated ? ' · Animated' : ''}</dd></div>
          {emoji.hexcode && <div><dt>Hexcode</dt><dd>{emoji.hexcode}</dd></div>}
          <div><dt>License</dt><dd>{emoji.license}</dd></div>
          <div><dt>Attribution</dt><dd>{emoji.attribution}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <dialog class="detail-lightbox" id="detail-lightbox" aria-label={`Preview ${emoji.name}`}>
    <div class="detail-lightbox-shell">
      <div class="detail-lightbox-toolbar">
        <span id="detail-lightbox-size">Original size</span>
        <div class="detail-lightbox-zoom-levels" role="group" aria-label="Zoom level">
          <button type="button" data-detail-zoom="fit">Fit</button>
          <button type="button" data-detail-zoom="1" class="is-active">1×</button>
          <button type="button" data-detail-zoom="2">2×</button>
          <button type="button" data-detail-zoom="4">4×</button>
        </div>
        <button class="detail-lightbox-close" id="detail-lightbox-close" type="button" aria-label="Close preview">×</button>
      </div>
      <div class="detail-lightbox-stage">
        <img id="detail-lightbox-image" src={imageUrl} alt={emoji.name} />
      </div>
    </div>
  </dialog>

  <script>
    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-copy]');
      if (!button) return;
      await navigator.clipboard.writeText(button.dataset.copy || '');
      const label = button.querySelector('strong');
      if (!label) return;
      const previous = label.textContent;
      label.textContent = 'Copied!';
      setTimeout(() => { label.textContent = previous; }, 900);
    });

    const previewZoomButton = document.querySelector('#detail-preview-zoom');
    const previewImage = document.querySelector('#detail-preview-image');
    const previewSize = document.querySelector('#detail-preview-size');
    const lightbox = document.querySelector('#detail-lightbox');
    const lightboxImage = document.querySelector('#detail-lightbox-image');
    const lightboxSize = document.querySelector('#detail-lightbox-size');
    const lightboxClose = document.querySelector('#detail-lightbox-close');
    const zoomButtons = [...document.querySelectorAll('[data-detail-zoom]')];

    const syncOriginalSize = () => {
      const sourceImage = lightboxImage instanceof HTMLImageElement ? lightboxImage : previewImage;
      if (!(sourceImage instanceof HTMLImageElement)) return;
      const width = sourceImage.naturalWidth || (previewImage instanceof HTMLImageElement ? previewImage.naturalWidth : 0);
      const height = sourceImage.naturalHeight || (previewImage instanceof HTMLImageElement ? previewImage.naturalHeight : 0);
      if (!width || !height) return;
      const label = `Original ${width}×${height}px`;
      if (previewSize) previewSize.textContent = label;
      if (lightboxSize) lightboxSize.textContent = label;
    };

    const setZoom = (value) => {
      if (!(lightboxImage instanceof HTMLImageElement)) return;
      const naturalWidth = lightboxImage.naturalWidth || 1;
      const naturalHeight = lightboxImage.naturalHeight || 1;

      if (value === 'fit') {
        lightboxImage.style.width = 'auto';
        lightboxImage.style.height = 'auto';
        lightboxImage.style.maxWidth = '100%';
        lightboxImage.style.maxHeight = '100%';
      } else {
        const level = Math.max(1, Number(value) || 1);
        lightboxImage.style.width = `${naturalWidth * level}px`;
        lightboxImage.style.height = `${naturalHeight * level}px`;
        lightboxImage.style.maxWidth = 'none';
        lightboxImage.style.maxHeight = 'none';
      }

      for (const button of zoomButtons) {
        button.classList.toggle('is-active', button.dataset.detailZoom === String(value));
      }
    };

    if (previewImage instanceof HTMLImageElement) {
      if (previewImage.complete) syncOriginalSize();
      else previewImage.addEventListener('load', syncOriginalSize, { once: true });
    }
    if (lightboxImage instanceof HTMLImageElement) {
      if (lightboxImage.complete) syncOriginalSize();
      else lightboxImage.addEventListener('load', syncOriginalSize, { once: true });
    }

    previewZoomButton?.addEventListener('click', () => {
      if (!(lightbox instanceof HTMLDialogElement)) return;
      syncOriginalSize();
      setZoom('1');
      lightbox.showModal();
    });

    for (const button of zoomButtons) {
      button.addEventListener('click', () => setZoom(button.dataset.detailZoom || '1'));
    }

    lightboxClose?.addEventListener('click', () => {
      if (lightbox instanceof HTMLDialogElement) lightbox.close();
    });

    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox && lightbox instanceof HTMLDialogElement) lightbox.close();
    });
  </script>
</Layout>

<style>
  .detail-page {
    padding-top: 28px;
    padding-bottom: 58px;
  }

  .back-link {
    margin-bottom: 18px;
  }

  .detail-grid {
    width: min(100%, 1080px);
    margin-inline: auto;
    grid-template-columns: minmax(300px, 410px) minmax(0, 1fr);
    gap: clamp(34px, 5vw, 68px);
    align-items: start;
  }

  .detail-preview {
    position: sticky;
    top: 86px;
    min-height: 0;
    padding: 12px;
  }

  .detail-preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 3px 5px 11px;
    color: var(--muted);
    font-size: .66rem;
    font-weight: 650;
  }

  .detail-preview-head > span:first-child {
    color: var(--ink);
    font-weight: 720;
  }

  .detail-preview-image-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .detail-preview-canvas {
    display: grid;
    width: 100%;
    min-height: 286px;
    place-items: center;
    padding: 30px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background-color: var(--surface-subtle);
    background-image:
      linear-gradient(45deg, color-mix(in srgb, var(--line) 42%, transparent) 25%, transparent 25%),
      linear-gradient(-45deg, color-mix(in srgb, var(--line) 42%, transparent) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, color-mix(in srgb, var(--line) 42%, transparent) 75%),
      linear-gradient(-45deg, transparent 75%, color-mix(in srgb, var(--line) 42%, transparent) 75%);
    background-size: 20px 20px;
    background-position: 0 0, 0 10px, 10px -10px, -10px 0;
  }

  .detail-preview-image-button img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 230px;
    object-fit: contain;
    filter: drop-shadow(0 10px 16px rgb(0 0 0 / .08));
  }

  .detail-preview-zoom-hint {
    display: flex;
    width: 100%;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-top: 9px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--muted);
    font-size: .69rem;
    font-weight: 680;
    pointer-events: none;
    transition: border-color .14s ease, color .14s ease, background .14s ease, transform .14s ease;
  }

  .detail-preview-zoom-hint svg {
    width: 15px;
    height: 15px;
  }

  .detail-preview-image-button:hover .detail-preview-zoom-hint,
  .detail-preview-image-button:focus-visible .detail-preview-zoom-hint {
    border-color: var(--line-strong);
    background: var(--surface-subtle);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .detail-content {
    min-width: 0;
    padding-top: 5px;
  }

  .detail-title-row {
    align-items: flex-start;
    gap: 14px;
  }

  .detail-title-row > div {
    min-width: 0;
  }

  .detail-title-row h1 {
    max-width: 650px;
    font-size: clamp(2.2rem, 4vw, 3.15rem);
    line-height: .97;
    letter-spacing: -.05em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .detail-native {
    flex: 0 0 auto;
    font-size: 1.9rem;
  }

  .copy-large {
    margin: 20px 0 14px;
    padding: 11px 14px;
  }

  .tag-list {
    gap: 6px;
    margin-bottom: 18px;
  }

  .tag-list.without-shortcode {
    margin-top: 20px;
  }

  .tag-list a {
    padding: 5px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--muted);
    font-size: .64rem;
    font-weight: 650;
    text-decoration: none;
    transition: transform .14s ease, border-color .14s ease, background .14s ease, color .14s ease;
  }

  .tag-list a:hover {
    transform: translateY(-1px);
    border-color: var(--line-strong);
    background: var(--surface-subtle);
    color: var(--ink);
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 20px;
  }

  .metadata-list {
    margin: 0;
  }

  .metadata-list div {
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 16px;
    padding: 11px 14px;
  }

  .metadata-list dd {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .detail-lightbox {
    width: min(94vw, 1100px);
    height: min(92vh, 900px);
    max-width: none;
    max-height: none;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 30px 90px rgba(16,24,40,.28);
  }

  .detail-lightbox::backdrop {
    background: rgba(16,24,40,.62);
    backdrop-filter: blur(3px);
  }

  .detail-lightbox-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100%;
  }

  .detail-lightbox-toolbar {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 8px 10px 8px 14px;
    border-bottom: 1px solid var(--line);
    background: #fff;
  }

  .detail-lightbox-toolbar > span {
    color: var(--muted);
    font-size: .7rem;
    font-weight: 650;
  }

  .detail-lightbox-zoom-levels {
    display: inline-flex;
    gap: 3px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-subtle);
  }

  .detail-lightbox-zoom-levels button,
  .detail-lightbox-close {
    min-width: 34px;
    height: 32px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-size: .7rem;
    font-weight: 720;
    cursor: pointer;
  }

  .detail-lightbox-zoom-levels button:hover,
  .detail-lightbox-close:hover {
    background: #fff;
    color: var(--ink);
  }

  .detail-lightbox-zoom-levels button.is-active {
    background: #fff;
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .detail-lightbox-close {
    font-size: 1.2rem;
  }

  .detail-lightbox-stage {
    display: grid;
    min-width: 0;
    min-height: 0;
    place-items: center;
    overflow: auto;
    padding: 32px;
    background: var(--surface-subtle);
  }

  .detail-lightbox-stage img {
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    object-fit: contain;
  }

  @media (max-width: 860px) {
    .detail-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .detail-preview {
      position: static;
      width: min(100%, 520px);
      margin-inline: auto;
    }

    .detail-content {
      width: min(100%, 640px);
      margin-inline: auto;
      padding-top: 0;
    }
  }

  @media (max-width: 680px) {
    .detail-page {
      padding-top: 22px;
      padding-bottom: 42px;
    }

    .back-link {
      margin-bottom: 14px;
    }

    .detail-preview {
      padding: 10px;
    }

    .detail-preview-head {
      padding-bottom: 9px;
    }

    .detail-preview-canvas {
      min-height: 230px;
      padding: 24px;
    }

    .detail-preview-image-button img {
      max-height: 190px;
    }

    .detail-title-row h1 {
      font-size: clamp(2rem, 11vw, 2.7rem);
    }

    .detail-actions > a {
      flex: 1 1 180px;
    }

    .metadata-list div {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 12px;
      padding: 10px 12px;
    }

    .detail-lightbox {
      width: 96vw;
      height: 88vh;
    }

    .detail-lightbox-toolbar {
      grid-template-columns: 1fr auto;
      gap: 8px;
    }

    .detail-lightbox-toolbar > span {
      grid-column: 1 / -1;
      order: 2;
      padding: 0 4px 4px;
    }

    .detail-lightbox-stage {
      padding: 20px;
    }
  }
</style>