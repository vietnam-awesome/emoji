---
import Layout from '../../layouts/Layout.astro';
import { getEmojiBySlug } from '../../lib/catalog-db.mjs';
import { emojiAssetUrl } from '../../lib/emojiAsset';
import { withBase } from '../../lib/url';

const base = import.meta.env.BASE_URL;
const browseUrl = withBase('/emojis', base);
const emoji = await getEmojiBySlug(Astro.params.slug);

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=300, s-maxage=86400, stale-while-revalidate=604800'
);

if (!emoji) Astro.response.status = 404;

const imageUrl = emoji ? emojiAssetUrl(emoji, base) : '';
const title = emoji
  ? `${emoji.name} — ${emoji.sourceLabel} | ePlus Emoji`
  : 'Emoji not found | ePlus Emoji';
const category = emoji ? (emoji.category || String(emoji.group || '').replaceAll('-', ' ')) : '';
const description = emoji
  ? `Download ${emoji.name} from ${emoji.sourceLabel}, copy :${emoji.shortcode}: and view source, format and license metadata.`
  : 'The requested emoji could not be found.';
---
<Layout title={title} description={description}>
  {emoji ? (
    <section class="shell detail-page">
      <a class="back-link" href={browseUrl}>← Back to emoji library</a>
      <div class="detail-grid">
        <div class="detail-preview">
          <img src={imageUrl} alt={emoji.name} width="320" height="320" />
        </div>
        <div class="detail-content">
          <div class="detail-title-row">
            <div>
              <p class="eyebrow">{emoji.sourceLabel}</p>
              <h1>{emoji.name}</h1>
            </div>
            {emoji.emoji && <span class="detail-native" aria-hidden="true">{emoji.emoji}</span>}
          </div>

          <button class="copy-large" type="button" data-copy={`:${emoji.shortcode}:`}>
            <span>:{emoji.shortcode}:</span>
            <strong>Copy shortcode</strong>
          </button>

          <div class="tag-list">
            {(emoji.tags || []).slice(0, 12).map((tag) => <span>{tag}</span>)}
          </div>

          <dl class="metadata-list">
            <div><dt>Category</dt><dd>{category}</dd></div>
            <div><dt>Source</dt><dd>{emoji.sourceLabel}</dd></div>
            <div><dt>Format</dt><dd>{String(emoji.format || '').toUpperCase()}{emoji.animated ? ' · Animated' : ''}</dd></div>
            {emoji.hexcode && <div><dt>Hexcode</dt><dd>{emoji.hexcode}</dd></div>}
            <div><dt>License</dt><dd>{emoji.license}</dd></div>
            <div><dt>Attribution</dt><dd>{emoji.attribution}</dd></div>
          </dl>

          <div class="detail-actions">
            <a class="primary-action" href={imageUrl} download>Download {String(emoji.format || '').toUpperCase()}</a>
            {emoji.sourceUrl && <a class="secondary-action" href={emoji.sourceUrl} rel="noreferrer">View original source</a>}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="shell detail-page">
      <a class="back-link" href={browseUrl}>← Back to emoji library</a>
      <div class="empty-state">
        <div>🫥</div>
        <h1>Emoji not found</h1>
        <p>This emoji does not exist in the current catalog.</p>
      </div>
    </section>
  )}

  <script>
    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-copy]');
      if (!button) return;
      await navigator.clipboard.writeText(button.dataset.copy);
      const label = button.querySelector('strong');
      if (!label) return;
      const previous = label.textContent;
      label.textContent = 'Copied!';
      setTimeout(() => { label.textContent = previous; }, 900);
    });
  </script>
</Layout>
