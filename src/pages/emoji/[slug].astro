---
import Layout from '../../layouts/Layout.astro';
import emojis from '../../data/emojis.json';
import { emojiAssetUrl } from '../../lib/emojiAsset';
import { emojiCategorySlug } from '../../lib/category';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  const fastBuild = process.env.FAST_BUILD === '1';
  const requestedLimit = Number.parseInt(process.env.FAST_BUILD_DETAIL_LIMIT || '300', 10);
  let detailRecords = emojis;

  if (fastBuild && Number.isFinite(requestedLimit) && requestedLimit > 0 && emojis.length > requestedLimit) {
    if (requestedLimit === 1) {
      detailRecords = [emojis[0]];
    } else {
      const sampled = [];
      const seen = new Set();
      for (let index = 0; index < requestedLimit; index += 1) {
        const recordIndex = Math.round((index * (emojis.length - 1)) / (requestedLimit - 1));
        if (seen.has(recordIndex)) continue;
        seen.add(recordIndex);
        sampled.push(emojis[recordIndex]);
      }
      detailRecords = sampled;
    }
  }

  if (fastBuild) {
    console.log(
      `[fast-build] rendering ${detailRecords.length.toLocaleString('en-US')} / ` +
      `${emojis.length.toLocaleString('en-US')} emoji detail pages`
    );
  }

  return detailRecords.map((emoji) => ({
    params: { slug: emoji.slug },
    props: { emoji }
  }));
}

const normalizeIdentity = (value) => String(value || '')
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '');

const { emoji } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = emojiAssetUrl(emoji, base);
const browseUrl = withBase('/emojis', base);
const title = `${emoji.name} — ${emoji.sourceLabel} | ePlus Emoji`;
const category = emoji.category || String(emoji.group || '').replaceAll('-', ' ');
const categorySlug = emojiCategorySlug(emoji);
const categoryUrl = withBase(`/categories/${categorySlug}`, base);
const hasDistinctShortcode = Boolean(
  emoji.shortcode && normalizeIdentity(emoji.shortcode) !== normalizeIdentity(emoji.name)
);
const tagTargetUrl = (tag) => {
  const tagIdentity = normalizeIdentity(tag);
  if (tagIdentity === 'animated') return `${browseUrl}?motion=yes`;

  const sourceIdentity = normalizeIdentity(emoji.source);
  const sourceLabelIdentity = normalizeIdentity(emoji.sourceLabel);
  if (emoji.source && tagIdentity && (tagIdentity === sourceIdentity || tagIdentity === sourceLabelIdentity)) {
    return `${browseUrl}?source=${encodeURIComponent(String(emoji.source).toLowerCase())}`;
  }

  if (tagIdentity && (tagIdentity === normalizeIdentity(category) || tagIdentity === normalizeIdentity(categorySlug))) {
    return categoryUrl;
  }

  return `${browseUrl}?q=${encodeURIComponent(tag)}`;
};
const description = hasDistinctShortcode
  ? `Download ${emoji.name} from ${emoji.sourceLabel}, copy :${emoji.shortcode}: and view source, format and license metadata.`
  : `Download ${emoji.name} from ${emoji.sourceLabel} and view source, format and license metadata.`;
---
<Layout title={title} description={description}>
  <section class="shell detail-page">
    <a class="back-link" href={browseUrl}>← Back to emoji library</a>
    <div class="detail-grid">
      <div class="detail-preview">
        <img src={imageUrl} alt={emoji.name} width="320" height="320" />
      </div>
      <div class="detail-content">
        <div class="detail-title-row">
          <div>
            <p class="eyebrow">{emoji.sourceLabel}</p>
            <h1>{emoji.name}</h1>
          </div>
          {emoji.emoji && <span class="detail-native" aria-hidden="true">{emoji.emoji}</span>}
        </div>

        {hasDistinctShortcode && (
          <button class="copy-large" type="button" data-copy={`:${emoji.shortcode}:`}>
            <span>:{emoji.shortcode}:</span>
            <strong>Copy shortcode</strong>
          </button>
        )}

        <div class:list={['tag-list', { 'without-shortcode': !hasDistinctShortcode }]} aria-label="Related emoji tags">
          {(emoji.tags || []).slice(0, 12).map((tag) => (
            <a href={tagTargetUrl(tag)} title={`Browse emoji related to ${tag}`}>{tag}</a>
          ))}
        </div>

        <dl class="metadata-list">
          <div><dt>Category</dt><dd><a href={categoryUrl}>{category}</a></dd></div>
          {hasDistinctShortcode && <div><dt>Shortcode</dt><dd>:{emoji.shortcode}:</dd></div>}
          {emoji.collection && <div><dt>Collection</dt><dd>{emoji.collection}</dd></div>}
          {emoji.style && <div><dt>Style</dt><dd>{emoji.style}</dd></div>}
          <div><dt>Source</dt><dd>{emoji.sourceLabel}</dd></div>
          <div><dt>Format</dt><dd>{String(emoji.format || '').toUpperCase()}{emoji.animated ? ' · Animated' : ''}</dd></div>
          {emoji.hexcode && <div><dt>Hexcode</dt><dd>{emoji.hexcode}</dd></div>}
          <div><dt>License</dt><dd>{emoji.license}</dd></div>
          <div><dt>Attribution</dt><dd>{emoji.attribution}</dd></div>
        </dl>

        <div class="detail-actions">
          <a class="primary-action" href={imageUrl} download>Download {String(emoji.format || '').toUpperCase()}</a>
          {emoji.sourceUrl && <a class="secondary-action" href={emoji.sourceUrl} rel="noreferrer">View original source</a>}
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-copy]');
      if (!button) return;
      await navigator.clipboard.writeText(button.dataset.copy || '');
      const label = button.querySelector('strong');
      if (!label) return;
      const previous = label.textContent;
      label.textContent = 'Copied!';
      setTimeout(() => { label.textContent = previous; }, 900);
    });
  </script>
</Layout>

<style>
  .tag-list.without-shortcode { margin-top: 24px; }
  .tag-list a {
    padding: 5px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    color: var(--muted);
    font-size: .64rem;
    font-weight: 650;
    text-decoration: none;
    transition: transform .14s ease, border-color .14s ease, background .14s ease, color .14s ease;
  }
  .tag-list a:hover {
    transform: translateY(-1px);
    border-color: var(--line-strong);
    background: var(--surface-subtle);
    color: var(--ink);
  }
</style>
