---
import Layout from '../../layouts/Layout.astro';
import EmojiDetail from '../../components/beui/EmojiDetail.astro';
import emojis from '../../data/emojis.json';
import { emojiCategorySlug } from '../../lib/category';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  const fastBuild = process.env.FAST_BUILD === '1';
  const requestedLimit = Number.parseInt(process.env.FAST_BUILD_DETAIL_LIMIT || '300', 10);
  let detailRecords = emojis;

  if (fastBuild && Number.isFinite(requestedLimit) && requestedLimit > 0 && emojis.length > requestedLimit) {
    if (requestedLimit === 1) {
      detailRecords = [emojis[0]];
    } else {
      const sampled = [];
      const seen = new Set();
      for (let index = 0; index < requestedLimit; index += 1) {
        const recordIndex = Math.round((index * (emojis.length - 1)) / (requestedLimit - 1));
        if (seen.has(recordIndex)) continue;
        seen.add(recordIndex);
        sampled.push(emojis[recordIndex]);
      }
      detailRecords = sampled;
    }
  }

  if (fastBuild) {
    console.log(
      `[fast-build] rendering ${detailRecords.length.toLocaleString('en-US')} / ` +
      `${emojis.length.toLocaleString('en-US')} emoji detail pages`
    );
  }

  return detailRecords.map((emoji) => ({
    params: { slug: emoji.slug },
    props: { emoji }
  }));
}

const normalizeIdentity = (value) => String(value || '')
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '');

const { emoji } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryName = emoji.category || String(emoji.group || '').replaceAll('-', ' ') || 'Other';
const categoryUrl = withBase(`/categories/${emojiCategorySlug(emoji)}`, base);
const breadcrumbs = [
  { name: 'Home', href: withBase('/', base) },
  { name: categoryName, href: categoryUrl },
  { name: emoji.name }
];
const hasDistinctShortcode = Boolean(
  emoji.shortcode && normalizeIdentity(emoji.shortcode) !== normalizeIdentity(emoji.name)
);
const title = `${emoji.name} — ${emoji.sourceLabel} | ePlus Emoji`;
const description = hasDistinctShortcode
  ? `Download ${emoji.name} from ${emoji.sourceLabel}, copy :${emoji.shortcode}: and view source, format and license metadata.`
  : `Download ${emoji.name} from ${emoji.sourceLabel} and view source, format and license metadata.`;
const keywords = [
  emoji.name,
  emoji.shortcode,
  categoryName,
  emoji.sourceLabel,
  ...(emoji.tags || []).slice(0, 8),
  'custom emoji',
  'emoji download'
].filter(Boolean);
---
<Layout title={title} description={description} keywords={keywords} breadcrumbs={breadcrumbs}>
  <EmojiDetail emoji={emoji} />
</Layout>
