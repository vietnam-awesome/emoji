---
import Layout from '../../layouts/Layout.astro';
import emojis from '../../data/emojis.json';
import { emojiAssetUrl } from '../../lib/emojiAsset';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  const fastBuild = process.env.FAST_BUILD === '1';
  const requestedLimit = Number.parseInt(process.env.FAST_BUILD_DETAIL_LIMIT || '300', 10);
  let detailRecords = emojis;

  if (fastBuild && Number.isFinite(requestedLimit) && requestedLimit > 0 && emojis.length > requestedLimit) {
    if (requestedLimit === 1) {
      detailRecords = [emojis[0]];
    } else {
      const sampled = [];
      const seen = new Set();
      for (let index = 0; index < requestedLimit; index += 1) {
        const recordIndex = Math.round((index * (emojis.length - 1)) / (requestedLimit - 1));
        if (seen.has(recordIndex)) continue;
        seen.add(recordIndex);
        sampled.push(emojis[recordIndex]);
      }
      detailRecords = sampled;
    }
  }

  if (fastBuild) {
    console.log(
      `[fast-build] rendering ${detailRecords.length.toLocaleString('en-US')} / ` +
      `${emojis.length.toLocaleString('en-US')} emoji detail pages`
    );
  }

  return detailRecords.map((emoji) => ({
    params: { slug: emoji.slug },
    props: { emoji }
  }));
}

const { emoji } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = emojiAssetUrl(emoji, base);
const browseUrl = withBase('/emojis', base);
const title = `${emoji.name} — ${emoji.sourceLabel} | ePlus Emoji`;
const category = emoji.category || String(emoji.group || '').replaceAll('-', ' ');
const description = `Download ${emoji.name} from ${emoji.sourceLabel}, copy :${emoji.shortcode}: and view source, format and license metadata.`;
---
<Layout title={title} description={description}>
  <section class="shell detail-page">
    <a class="back-link" href={browseUrl}>← Back to emoji library</a>
    <div class="detail-grid">
      <div class="detail-preview">
        <img src={imageUrl} alt={emoji.name} width="320" height="320" />
      </div>
      <div class="detail-content">
        <div class="detail-title-row">
          <div>
            <p class="eyebrow">{emoji.sourceLabel}</p>
            <h1>{emoji.name}</h1>
          </div>
          {emoji.emoji && <span class="detail-native" aria-hidden="true">{emoji.emoji}</span>}
        </div>

        <button class="copy-large" type="button" data-copy={`:${emoji.shortcode}:`}>
          <span>:{emoji.shortcode}:</span>
          <strong>Copy shortcode</strong>
        </button>

        <div class="tag-list">
          {(emoji.tags || []).slice(0, 12).map((tag) => <span>{tag}</span>)}
        </div>

        <dl class="metadata-list">
          <div><dt>Category</dt><dd>{category}</dd></div>
          {emoji.collection && <div><dt>Collection</dt><dd>{emoji.collection}</dd></div>}
          {emoji.style && <div><dt>Style</dt><dd>{emoji.style}</dd></div>}
          <div><dt>Source</dt><dd>{emoji.sourceLabel}</dd></div>
          <div><dt>Format</dt><dd>{String(emoji.format || '').toUpperCase()}{emoji.animated ? ' · Animated' : ''}</dd></div>
          {emoji.hexcode && <div><dt>Hexcode</dt><dd>{emoji.hexcode}</dd></div>}
          <div><dt>License</dt><dd>{emoji.license}</dd></div>
          <div><dt>Attribution</dt><dd>{emoji.attribution}</dd></div>
        </dl>

        <div class="detail-actions">
          <a class="primary-action" href={imageUrl} download>Download {String(emoji.format || '').toUpperCase()}</a>
          {emoji.sourceUrl && <a class="secondary-action" href={emoji.sourceUrl} rel="noreferrer">View original source</a>}
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-copy]');
      if (!button) return;
      await navigator.clipboard.writeText(button.dataset.copy || '');
      const label = button.querySelector('strong');
      if (!label) return;
      const previous = label.textContent;
      label.textContent = 'Copied!';
      setTimeout(() => { label.textContent = previous; }, 900);
    });
  </script>
</Layout>
