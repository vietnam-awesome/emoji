---
import Layout from '../../layouts/Layout.astro';
import EmojiCard from '../../components/EmojiCard.astro';
import { catalogConfig } from '../../config/catalog';
import { getCatalogFacets, listEmoji } from '../../lib/catalog-db.mjs';
import '../../styles/pagination.css';

const PAGE_SIZE = catalogConfig.pageSize;
const params = Astro.url.searchParams;
const q = String(params.get('q') || '').trim();
const category = String(params.get('category') || params.get('group') || '').trim().toLowerCase();
const source = String(params.get('source') || '').trim().toLowerCase();
const motion = ['yes', 'no'].includes(String(params.get('motion'))) ? String(params.get('motion')) : '';
const mode = params.get('view') === 'pagination' ? 'pagination' : 'scroll';
const requestedPage = Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1);

const [result, facets] = await Promise.all([
  listEmoji({ q, category, source, motion, page: requestedPage, pageSize: PAGE_SIZE }),
  getCatalogFacets()
]);

Astro.response.headers.set(
  'Cache-Control',
  q ? 'public, max-age=30, s-maxage=120' : 'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

function browseUrl(overrides = {}) {
  const next = new URLSearchParams();
  const values = {
    q,
    category,
    source,
    motion,
    view: mode,
    page: result.page,
    ...overrides
  };

  if (values.q) next.set('q', values.q);
  if (values.category) next.set('category', values.category);
  if (values.source) next.set('source', values.source);
  if (values.motion) next.set('motion', values.motion);
  if (values.view) next.set('view', values.view);
  if (Number(values.page) > 1) next.set('page', String(values.page));
  const query = next.toString();
  return `/emojis${query ? `?${query}` : ''}`;
}

function paginationItems(totalPages, currentPage) {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);
  const values = [1];
  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);
  if (start > 2) values.push('ellipsis-start');
  for (let page = start; page <= end; page += 1) values.push(page);
  if (end < totalPages - 1) values.push('ellipsis-end');
  values.push(totalPages);
  return values;
}

const start = result.total ? (result.page - 1) * PAGE_SIZE + 1 : 0;
const end = Math.min(result.page * PAGE_SIZE, result.total);
const nextUrl = result.page < result.totalPages ? browseUrl({ page: result.page + 1 }) : '';
const prevUrl = result.page > 1 ? browseUrl({ page: result.page - 1 }) : '';
const pageItems = paginationItems(result.totalPages, result.page);
const hasActiveFilters = Boolean(q || source || category || motion);
---
<Layout
  title="Browse all emoji — ePlus Emoji"
  description="Search the complete ePlus Emoji catalog by name, shortcode, category, source and animation type."
>
  <section
    class="shell catalog-page"
    id="explorer"
    aria-labelledby="page-title"
    data-total={result.total}
    data-page={result.page}
    data-page-size={PAGE_SIZE}
    data-next-url={nextUrl}
    data-scroll-root-margin={catalogConfig.scrollRootMargin}
  >
    <header class="browse-header">
      <p class="eyebrow">Emoji directory</p>
      <h1 id="page-title">Browse emoji</h1>
      <p>Search and filter the catalog directly from the database. Only the current result page is transferred.</p>
    </header>

    <form class="catalog-controls" id="catalog-filter-form" method="get" action="/emojis" aria-label="Emoji search and filters">
      <input type="hidden" name="view" value={mode} />
      <label class="search-box catalog-search">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <span class="sr-only">Search emoji</span>
        <input id="emoji-search" name="q" value={q} type="search" placeholder="Search emoji, :shortcode:, tag or category" autocomplete="off" />
        <button class="catalog-search-submit" type="submit" aria-label="Search">
          <span class="search-submit-label">Search</span>
          <span class="search-submit-spinner" aria-hidden="true"></span>
        </button>
      </label>

      <div class="filter-row">
        <select id="category-filter" name="category" aria-label="Filter by category">
          <option value="">All categories</option>
          {facets.categories.map((item) => (
            <option value={item.slug} selected={category === item.slug}>{item.name} · {item.count.toLocaleString('en-US')}</option>
          ))}
        </select>
        <select id="source-filter" name="source" aria-label="Filter by source">
          <option value="">All sources</option>
          {facets.sources.map((item) => (
            <option value={item.slug} selected={source === item.slug}>{item.name} · {item.count.toLocaleString('en-US')}</option>
          ))}
        </select>
        <select id="motion-filter" name="motion" aria-label="Filter by animation">
          <option value="" selected={!motion}>Static + animated</option>
          <option value="yes" selected={motion === 'yes'}>Animated only</option>
          <option value="no" selected={motion === 'no'}>Static only</option>
        </select>
        {hasActiveFilters && <a class="clear-filters" href={browseUrl({ q: '', source: '', category: '', motion: '', page: 1 })}>Clear</a>}
      </div>
    </form>

    <div class="catalog-request-state" id="catalog-request-state" role="status" aria-live="polite" hidden>
      <span class="catalog-request-spinner" aria-hidden="true"></span>
      <span id="catalog-request-text">Updating results…</span>
    </div>

    <div class="results-toolbar">
      <p class="results-summary" id="range-count" aria-live="polite">
        {result.total
          ? `Showing ${start.toLocaleString('en-US')}–${end.toLocaleString('en-US')} of ${result.total.toLocaleString('en-US')}`
          : 'No emoji found'}
      </p>

      <div class="browse-mode-switcher" role="group" aria-label="Choose how emoji are loaded">
        <a
          class:list={['browse-mode-button', { 'is-active': mode === 'scroll' }]}
          href={browseUrl({ view: 'scroll', page: 1 })}
          aria-pressed={mode === 'scroll' ? 'true' : 'false'}
          title="Automatically load more as you scroll"
        ><span aria-hidden="true">↕</span> Scroll</a>
        <a
          class:list={['browse-mode-button', { 'is-active': mode === 'pagination' }]}
          href={browseUrl({ view: 'pagination', page: 1 })}
          aria-pressed={mode === 'pagination' ? 'true' : 'false'}
          title="Browse with page numbers"
        ><span aria-hidden="true">☷</span> Pages</a>
      </div>
    </div>

    <div class="emoji-grid" id="emoji-grid">
      {result.items.map((emoji) => <EmojiCard emoji={emoji} />)}
    </div>

    {result.total === 0 && (
      <div class="empty-state" id="empty-state">
        <div>🫥</div>
        <h2>No emoji found</h2>
        <p>Try another keyword or clear one of the filters.</p>
      </div>
    )}

    {mode === 'scroll' && nextUrl && (
      <div class="infinite-loader" id="infinite-loader">
        <span class="infinite-loader-spinner" id="infinite-loader-spinner" aria-hidden="true"></span>
        <span id="infinite-loader-status">{end.toLocaleString('en-US')} of {result.total.toLocaleString('en-US')} loaded</span>
        <button class="load-more-fallback" id="load-more-fallback" type="button">Load {PAGE_SIZE} more</button>
      </div>
    )}

    {mode === 'pagination' && result.totalPages > 1 && (
      <nav class="pagination" id="pagination" aria-label="Emoji pagination">
        {prevUrl ? <a class="pagination-nav" href={prevUrl}>← Prev</a> : <span class="pagination-nav is-disabled">← Prev</span>}
        <div class="pagination-pages">
          {pageItems.map((item) => typeof item === 'string'
            ? <span class="pagination-ellipsis">…</span>
            : <a class:list={['pagination-page', { 'is-active': item === result.page }]} href={browseUrl({ page: item })}>{item}</a>
          )}
        </div>
        {nextUrl ? <a class="pagination-nav" href={nextUrl}>Next →</a> : <span class="pagination-nav is-disabled">Next →</span>}
      </nav>
    )}
  </section>

  <script>
    const explorer = document.querySelector('#explorer');
    const grid = document.querySelector('#emoji-grid');
    const filterForm = document.querySelector('#catalog-filter-form');
    const source = document.querySelector('#source-filter');
    const category = document.querySelector('#category-filter');
    const motion = document.querySelector('#motion-filter');
    const searchInput = document.querySelector('#emoji-search');
    const searchSubmit = document.querySelector('.catalog-search-submit');
    const requestState = document.querySelector('#catalog-request-state');
    const requestText = document.querySelector('#catalog-request-text');
    const loader = document.querySelector('#infinite-loader');
    const loaderSpinner = document.querySelector('#infinite-loader-spinner');
    const loadMore = document.querySelector('#load-more-fallback');
    const loaderStatus = document.querySelector('#infinite-loader-status');
    const pageSize = Math.max(1, Number.parseInt(explorer?.dataset.pageSize || '48', 10));
    const total = Math.max(0, Number.parseInt(explorer?.dataset.total || '0', 10));
    let nextUrl = explorer?.dataset.nextUrl || '';
    let pageLoading = false;
    let navigationLoading = false;

    function setNavigationLoading(message = 'Updating results…') {
      if (navigationLoading) return;
      navigationLoading = true;
      explorer?.classList.add('is-query-loading');
      explorer?.setAttribute('aria-busy', 'true');
      grid?.setAttribute('aria-busy', 'true');
      if (requestState) requestState.hidden = false;
      if (requestText) requestText.textContent = message;
      searchSubmit?.classList.add('is-loading');
      searchSubmit?.setAttribute('aria-disabled', 'true');
      for (const control of [searchInput, source, category, motion]) {
        if (control) control.disabled = true;
      }
    }

    function resetNavigationLoading() {
      navigationLoading = false;
      explorer?.classList.remove('is-query-loading');
      explorer?.removeAttribute('aria-busy');
      grid?.removeAttribute('aria-busy');
      if (requestState) requestState.hidden = true;
      searchSubmit?.classList.remove('is-loading');
      searchSubmit?.removeAttribute('aria-disabled');
      for (const control of [searchInput, source, category, motion]) {
        if (control) control.disabled = false;
      }
    }

    for (const control of [source, category, motion]) {
      control?.addEventListener('change', () => filterForm?.requestSubmit());
    }

    filterForm?.addEventListener('submit', () => {
      const term = String(searchInput?.value || '').trim();
      setNavigationLoading(term ? `Searching for “${term}”…` : 'Updating results…');
    });

    document.addEventListener('click', async (event) => {
      const copyButton = event.target.closest('[data-copy]');
      if (copyButton) {
        await navigator.clipboard.writeText(copyButton.dataset.copy || '');
        return;
      }

      const navigationLink = event.target.closest('.clear-filters, .browse-mode-button, .pagination a');
      if (navigationLink && !event.defaultPrevented && event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
        setNavigationLoading('Loading results…');
      }
    });

    async function loadNextPage() {
      if (!nextUrl || pageLoading || !grid) return;
      pageLoading = true;
      loaderSpinner?.classList.add('is-loading');
      if (loadMore) loadMore.disabled = true;
      if (loaderStatus) loaderStatus.textContent = 'Loading more emoji…';

      try {
        const response = await fetch(nextUrl, { headers: { Accept: 'text/html' } });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const incomingGrid = doc.querySelector('#emoji-grid');
        const incomingExplorer = doc.querySelector('#explorer');
        if (!incomingGrid || !incomingExplorer) throw new Error('Invalid browse response');

        const fragment = document.createDocumentFragment();
        for (const card of incomingGrid.querySelectorAll('[data-emoji-card]')) {
          fragment.append(card);
        }
        grid.append(fragment);
        nextUrl = incomingExplorer.dataset.nextUrl || '';
        if (explorer) explorer.dataset.nextUrl = nextUrl;
        const loaded = grid.querySelectorAll('[data-emoji-card]').length;
        if (loaderStatus) loaderStatus.textContent = `${Math.min(loaded, total).toLocaleString('en-US')} of ${total.toLocaleString('en-US')} loaded`;
        if (!nextUrl && loader) loader.hidden = true;
      } catch (error) {
        console.error('Could not load the next emoji page', error);
        if (loaderStatus) loaderStatus.textContent = 'Could not load more emoji. Try again.';
      } finally {
        pageLoading = false;
        loaderSpinner?.classList.remove('is-loading');
        if (loadMore) loadMore.disabled = false;
      }
    }

    loadMore?.addEventListener('click', loadNextPage);

    if (loader && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) loadNextPage();
      }, { rootMargin: explorer?.dataset.scrollRootMargin || '700px 0px' });
      observer.observe(loader);
    }

    window.addEventListener('pageshow', resetNavigationLoading);
  </script>
</Layout>
