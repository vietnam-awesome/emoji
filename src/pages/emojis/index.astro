---
import Layout from '../../layouts/Layout.astro';
import EmojiCard from '../../components/EmojiCard.astro';
import CatalogBeuiEnhancer from '../../components/beui/CatalogBeuiEnhancer';
import { catalogConfig } from '../../config/catalog';
import emojis from '../../data/emojis.json';
import '../../styles/pagination.css';

const PAGE_SIZE = catalogConfig.pageSize;
const initialItems = emojis.slice(0, PAGE_SIZE);

const categoryCounts = new Map();
const sourceCounts = new Map();
for (const emoji of emojis) {
  const categorySlug = String(emoji.categorySlug || emoji.category || 'other').toLowerCase();
  const categoryName = String(emoji.category || 'Other');
  const currentCategory = categoryCounts.get(categorySlug) || { slug: categorySlug, name: categoryName, count: 0 };
  currentCategory.count += 1;
  categoryCounts.set(categorySlug, currentCategory);

  const sourceSlug = String(emoji.source || '').toLowerCase();
  if (sourceSlug) {
    const sourceName = String(emoji.sourceLabel || emoji.source || sourceSlug);
    const currentSource = sourceCounts.get(sourceSlug) || { slug: sourceSlug, name: sourceName, count: 0 };
    currentSource.count += 1;
    sourceCounts.set(sourceSlug, currentSource);
  }
}

const categories = [...categoryCounts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const sources = [...sourceCounts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const animatedCount = emojis.filter((emoji) => emoji.animated).length;
const staticCount = emojis.length - animatedCount;
const browseSelects = [
  {
    proxyId: 'category-filter',
    label: 'Filter by category',
    icon: 'category',
    options: [
      { value: '', label: `All categories · ${emojis.length.toLocaleString('en-US')}` },
      ...categories.map((item) => ({ value: item.slug, label: `${item.name} · ${item.count.toLocaleString('en-US')}` }))
    ]
  },
  {
    proxyId: 'source-filter',
    label: 'Filter by source',
    icon: 'source',
    options: [
      { value: '', label: `All sources · ${emojis.length.toLocaleString('en-US')}` },
      ...sources.map((item) => ({ value: item.slug, label: `${item.name} · ${item.count.toLocaleString('en-US')}` }))
    ]
  },
  {
    proxyId: 'motion-filter',
    label: 'Filter by animation',
    icon: 'motion',
    options: [
      { value: '', label: `Static + animated · ${emojis.length.toLocaleString('en-US')}` },
      { value: 'yes', label: `Animated only · ${animatedCount.toLocaleString('en-US')}` },
      { value: 'no', label: `Static only · ${staticCount.toLocaleString('en-US')}` }
    ]
  }
];
---
<Layout
  title="Browse all emoji — ePlus Emoji"
  description="Search the ePlus Emoji catalog with a sharded static search index generated by GitHub Actions."
>
  <section
    class="shell catalog-page"
    id="explorer"
    aria-labelledby="page-title"
    data-total={emojis.length}
    data-page-size={PAGE_SIZE}
    data-search-root={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/search`}
    data-base={import.meta.env.BASE_URL}
  >
    <header class="browse-header">
      <p class="eyebrow">Emoji directory</p>
      <h1 id="page-title">Browse emoji</h1>
      <p>Search and filter a static index generated during deployment. Only the matching index shard and result chunks are downloaded.</p>
    </header>

    <form class="catalog-controls" id="catalog-filter-form" role="search" aria-label="Emoji search and filters">
      <label class="search-box catalog-search beui-native-proxy-block" aria-hidden="true">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <span class="sr-only">Search emoji</span>
        <input id="emoji-search" type="search" placeholder="Search emoji, :shortcode:, tag or category" autocomplete="off" tabindex="-1" />
        <button class="catalog-search-submit" type="submit" aria-label="Search" tabindex="-1">
          <span class="search-submit-label">Search</span>
          <span class="search-submit-spinner" aria-hidden="true"></span>
        </button>
      </label>

      <div class="filter-row beui-native-proxy-block" aria-hidden="true">
        <select id="category-filter" aria-label="Filter by category" tabindex="-1">
          <option value="">All categories · {emojis.length.toLocaleString('en-US')}</option>
          {categories.map((item) => <option value={item.slug}>{item.name} · {item.count.toLocaleString('en-US')}</option>)}
        </select>
        <select id="source-filter" aria-label="Filter by source" tabindex="-1">
          <option value="">All sources · {emojis.length.toLocaleString('en-US')}</option>
          {sources.map((item) => <option value={item.slug}>{item.name} · {item.count.toLocaleString('en-US')}</option>)}
        </select>
        <select id="motion-filter" aria-label="Filter by animation" tabindex="-1">
          <option value="">Static + animated · {emojis.length.toLocaleString('en-US')}</option>
          <option value="yes">Animated only · {animatedCount.toLocaleString('en-US')}</option>
          <option value="no">Static only · {staticCount.toLocaleString('en-US')}</option>
        </select>
        <button class="clear-filters" id="clear-filters" type="button" hidden tabindex="-1">Clear</button>
      </div>

      <CatalogBeuiEnhancer
        search={{
          proxyId: 'emoji-search',
          placeholder: 'Search emoji, :shortcode:, tag or category',
          label: 'Search emoji',
          submitProxySelector: '.catalog-search-submit',
          showSubmit: true
        }}
        selects={browseSelects}
        clearProxyId="clear-filters"
        className="beui-catalog-control-stack"
        client:load
      />
    </form>

    <div class="results-toolbar">
      <p class="results-summary" id="range-count" aria-live="polite">
        Showing 1–{Math.min(PAGE_SIZE, emojis.length).toLocaleString('en-US')} of {emojis.length.toLocaleString('en-US')}
      </p>
      <div class="browse-mode-switcher beui-native-proxy" role="group" aria-label="Choose how emoji are loaded" aria-hidden="true">
        <button class="browse-mode-button is-active" type="button" data-browse-mode="scroll" aria-pressed="true" tabindex="-1"><span aria-hidden="true">↕</span> Scroll</button>
        <button class="browse-mode-button" type="button" data-browse-mode="pagination" aria-pressed="false" tabindex="-1"><span aria-hidden="true">☷</span> Pages</button>
      </div>
      <CatalogBeuiEnhancer
        mode={{ proxySelector: '#explorer .browse-mode-switcher', label: 'Choose how emoji are loaded' }}
        className="beui-mode-control"
        client:load
      />
    </div>

    <div class="catalog-results-stage" id="catalog-results-stage">
      <div class="catalog-loading-overlay" id="catalog-loading-overlay" role="status" aria-live="polite" hidden>
        <div class="catalog-loading-shell">
          <div class="catalog-loading-copy">
            <strong id="catalog-loading-title">Searching emoji…</strong>
            <span id="catalog-loading-detail">Loading the matching search shard and results.</span>
          </div>
          <div class="catalog-skeleton-grid" aria-hidden="true">
            {Array.from({ length: 12 }).map(() => (
              <div class="catalog-skeleton-card">
                <div class="catalog-skeleton-media"></div>
                <div class="catalog-skeleton-body">
                  <span class="catalog-skeleton-line catalog-skeleton-line--title"></span>
                  <span class="catalog-skeleton-line"></span>
                  <span class="catalog-skeleton-line catalog-skeleton-line--meta"></span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="emoji-grid" id="emoji-grid">
        {initialItems.map((emoji) => <EmojiCard emoji={emoji} />)}
      </div>

      <div class="empty-state" id="empty-state" hidden>
        <div>🫥</div>
        <h2>No emoji found</h2>
        <p>Try another keyword or clear one of the filters.</p>
      </div>
    </div>

    <div class="infinite-loader" id="infinite-loader" hidden={emojis.length <= PAGE_SIZE}>
      <span class="infinite-loader-spinner" id="infinite-loader-spinner" aria-hidden="true"></span>
      <span id="infinite-loader-status">{Math.min(PAGE_SIZE, emojis.length).toLocaleString('en-US')} of {emojis.length.toLocaleString('en-US')} loaded</span>
      <button class="load-more-fallback" id="load-more-fallback" type="button">Load {PAGE_SIZE} more</button>
    </div>

    <nav class="pagination" id="pagination" aria-label="Emoji pagination" hidden>
      <button class="pagination-nav" type="button" data-page-action="prev">← Prev</button>
      <div class="pagination-pages" id="pagination-pages"></div>
      <button class="pagination-nav" type="button" data-page-action="next">Next →</button>
    </nav>
  </section>

  <script>
    const explorer = document.querySelector('#explorer');
    const grid = document.querySelector('#emoji-grid');
    const form = document.querySelector('#catalog-filter-form');
    const search = document.querySelector('#emoji-search');
    const category = document.querySelector('#category-filter');
    const source = document.querySelector('#source-filter');
    const motion = document.querySelector('#motion-filter');
    const clearFilters = document.querySelector('#clear-filters');
    const rangeCount = document.querySelector('#range-count');
    const emptyState = document.querySelector('#empty-state');
    const overlay = document.querySelector('#catalog-loading-overlay');
    const loadingTitle = document.querySelector('#catalog-loading-title');
    const loadingDetail = document.querySelector('#catalog-loading-detail');
    const searchSubmit = document.querySelector('.catalog-search-submit');
    const infiniteLoader = document.querySelector('#infinite-loader');
    const infiniteSpinner = document.querySelector('#infinite-loader-spinner');
    const infiniteStatus = document.querySelector('#infinite-loader-status');
    const loadMoreButton = document.querySelector('#load-more-fallback');
    const pagination = document.querySelector('#pagination');
    const paginationPages = document.querySelector('#pagination-pages');
    const previousButton = pagination?.querySelector('[data-page-action="prev"]');
    const nextButton = pagination?.querySelector('[data-page-action="next"]');
    const modeButtons = [...document.querySelectorAll('[data-browse-mode]')];

    const PAGE_SIZE = Math.max(1, Number.parseInt(explorer?.dataset.pageSize || '48', 10));
    const searchRoot = explorer?.dataset.searchRoot || '/search';
    const base = explorer?.dataset.base || '/';
    const basePrefix = base === '/' ? '' : base.replace(/\/$/, '');
    const chunkCache = new Map();
    const jsonCache = new Map();
    let manifestPromise;
    let resultIds = null;
    let resultTotal = Math.max(0, Number.parseInt(explorer?.dataset.total || '0', 10));
    let currentPage = 1;
    let visibleCount = PAGE_SIZE;
    let mode = 'scroll';
    let busy = false;
    let observer;

    const params = new URLSearchParams(window.location.search);
    search.value = params.get('q') || '';
    category.value = params.get('category') || '';
    source.value = params.get('source') || '';
    motion.value = params.get('motion') || '';
    mode = params.get('view') === 'pagination' ? 'pagination' : 'scroll';
    currentPage = Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1);

    function normalizeSearch(value) {
      return String(value || '')
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    }

    function searchUrl(path) {
      return `${searchRoot}/${String(path).replace(/^\/+/, '')}`;
    }

    async function fetchJson(path) {
      const url = searchUrl(path);
      if (!jsonCache.has(url)) {
        jsonCache.set(url, fetch(url).then((response) => {
          if (!response.ok) throw new Error(`Search asset ${url} returned HTTP ${response.status}`);
          return response.json();
        }).catch((error) => {
          jsonCache.delete(url);
          throw error;
        }));
      }
      return jsonCache.get(url);
    }

    function getManifest() {
      if (!manifestPromise) manifestPromise = fetchJson('manifest.json');
      return manifestPromise;
    }

    function intersectSorted(a, b) {
      const right = new Set(b);
      return a.filter((id) => right.has(id));
    }

    async function idsForToken(token) {
      const prefix = token.slice(0, Math.min(2, token.length));
      if (!prefix) return [];
      let shard;
      try {
        shard = await fetchJson(`q/${prefix}.json`);
      } catch {
        return [];
      }
      const ids = new Set();
      for (const [indexedToken, tokenIds] of Object.entries(shard)) {
        if (!indexedToken.startsWith(token)) continue;
        for (const id of tokenIds) ids.add(id);
      }
      return [...ids].sort((a, b) => a - b);
    }

    async function idsForQuery(value) {
      const tokens = normalizeSearch(value).split(/\s+/).filter(Boolean).slice(0, 6);
      if (!tokens.length) return null;
      const lists = await Promise.all(tokens.map(idsForToken));
      if (lists.some((list) => list.length === 0)) return [];
      lists.sort((a, b) => a.length - b.length);
      return lists.slice(1).reduce((ids, list) => intersectSorted(ids, list), lists[0]);
    }

    async function idsForFacet(kind, value, manifest) {
      if (!value) return null;
      if (kind === 'motion') return fetchJson(`facets/motion/${value}.json`);
      const list = kind === 'category' ? manifest.categories : manifest.sources;
      const item = list.find((entry) => entry.value === value);
      if (!item) return [];
      return fetchJson(`facets/${kind}/${item.file}`);
    }

    async function resolveIds() {
      const manifest = await getManifest();
      const lists = [];
      const queryIds = await idsForQuery(search.value);
      if (queryIds) lists.push(queryIds);
      const [categoryIds, sourceIds, motionIds] = await Promise.all([
        idsForFacet('category', category.value, manifest),
        idsForFacet('source', source.value, manifest),
        idsForFacet('motion', motion.value, manifest)
      ]);
      for (const ids of [categoryIds, sourceIds, motionIds]) if (ids) lists.push(ids);
      if (!lists.length) return null;
      lists.sort((a, b) => a.length - b.length);
      return lists.slice(1).reduce((ids, list) => intersectSorted(ids, list), lists[0]);
    }

    function expandRecord(row) {
      return {
        slug: row.s,
        name: row.n,
        shortcode: row.c,
        group: row.g,
        category: row.ca,
        categorySlug: row.cs,
        tags: row.t || [],
        source: row.src,
        sourceLabel: row.sl,
        image: row.i,
        format: row.f,
        animated: Boolean(row.a),
        emoji: row.e || '',
        hexcode: row.h || '',
        collection: row.co || '',
        style: row.st || '',
        topics: row.tp || []
      };
    }

    async function getChunk(chunkIndex) {
      if (!chunkCache.has(chunkIndex)) {
        chunkCache.set(chunkIndex, fetchJson(`chunks/${String(chunkIndex).padStart(4, '0')}.json`));
      }
      return chunkCache.get(chunkIndex);
    }

    async function recordsForIds(ids) {
      const manifest = await getManifest();
      const needed = [...new Set(ids.map((id) => Math.floor(id / manifest.chunkSize)))];
      await Promise.all(needed.map(getChunk));
      return Promise.all(ids.map(async (id) => {
        const chunkIndex = Math.floor(id / manifest.chunkSize);
        const chunk = await getChunk(chunkIndex);
        return expandRecord(chunk[id % manifest.chunkSize]);
      }));
    }

    function idsForRange(start, end) {
      if (resultIds) return resultIds.slice(start, end);
      return Array.from({ length: Math.max(0, Math.min(end, resultTotal) - start) }, (_, index) => start + index);
    }

    function assetUrl(emoji) {
      if (!emoji.image) return '';
      if (emoji.image.startsWith('/')) return `${basePrefix}${emoji.image}`;
      return emoji.image;
    }

    function createEmojiCard(emoji) {
      const article = document.createElement('article');
      article.className = 'emoji-card';
      article.dataset.emojiCard = '';

      const preview = document.createElement('a');
      preview.className = 'emoji-preview';
      preview.href = `${basePrefix}/emoji/${encodeURIComponent(emoji.slug)}`;
      preview.setAttribute('aria-label', `Open ${emoji.name}`);

      const image = document.createElement('img');
      image.src = assetUrl(emoji);
      image.alt = emoji.name;
      image.loading = 'lazy';
      image.width = 128;
      image.height = 128;
      preview.append(image);

      if (emoji.animated) {
        const badge = document.createElement('span');
        badge.className = 'card-motion-badge';
        badge.textContent = 'GIF';
        preview.append(badge);
      }

      const body = document.createElement('div');
      body.className = 'emoji-card-body';
      const titleRow = document.createElement('div');
      titleRow.className = 'emoji-title-row';
      const name = document.createElement('a');
      name.className = 'emoji-name';
      name.href = preview.href;
      name.textContent = emoji.name;
      const nativeEmoji = document.createElement('span');
      nativeEmoji.className = 'native-emoji';
      nativeEmoji.setAttribute('aria-hidden', 'true');
      nativeEmoji.textContent = emoji.emoji || '';
      titleRow.append(name, nativeEmoji);

      const shortcode = document.createElement('button');
      shortcode.className = 'shortcode';
      shortcode.type = 'button';
      shortcode.dataset.copy = `:${emoji.shortcode}:`;
      shortcode.title = 'Copy shortcode';
      shortcode.textContent = `:${emoji.shortcode}:`;

      const meta = document.createElement('div');
      meta.className = 'emoji-meta';
      const categoryText = document.createElement('span');
      categoryText.textContent = emoji.category || emoji.group || 'Other';
      const formatText = document.createElement('span');
      formatText.textContent = emoji.animated ? 'Animated' : String(emoji.format || 'Static').toUpperCase();
      meta.append(categoryText, formatText);
      body.append(titleRow, shortcode, meta);
      article.append(preview, body);
      return article;
    }

    function setLoading(title, detail) {
      busy = true;
      explorer?.classList.add('is-query-loading');
      explorer?.setAttribute('aria-busy', 'true');
      if (overlay) overlay.hidden = false;
      if (loadingTitle) loadingTitle.textContent = title;
      if (loadingDetail) loadingDetail.textContent = detail;
      searchSubmit?.classList.add('is-loading');
    }

    function clearLoading() {
      busy = false;
      explorer?.classList.remove('is-query-loading');
      explorer?.removeAttribute('aria-busy');
      if (overlay) overlay.hidden = true;
      searchSubmit?.classList.remove('is-loading');
    }

    function hasFilters() {
      return Boolean(search.value.trim() || category.value || source.value || motion.value);
    }

    function syncUrl() {
      const url = new URL(window.location.href);
      const values = {
        q: search.value.trim(),
        category: category.value,
        source: source.value,
        motion: motion.value
      };
      for (const [key, value] of Object.entries(values)) {
        if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
      }
      url.searchParams.set('view', mode);
      if (mode === 'pagination' && currentPage > 1) url.searchParams.set('page', String(currentPage));
      else url.searchParams.delete('page');
      window.history.replaceState({}, '', url);
    }

    function updateModeUi() {
      for (const button of modeButtons) {
        const active = button.dataset.browseMode === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
      pagination.hidden = mode !== 'pagination' || resultTotal <= PAGE_SIZE;
      infiniteLoader.hidden = mode !== 'scroll' || visibleCount >= resultTotal;
    }

    function paginationItems(totalPages) {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);
      const values = [1];
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      if (start > 2) values.push('ellipsis-start');
      for (let page = start; page <= end; page += 1) values.push(page);
      if (end < totalPages - 1) values.push('ellipsis-end');
      values.push(totalPages);
      return values;
    }

    function renderPagination() {
      const totalPages = Math.max(1, Math.ceil(resultTotal / PAGE_SIZE));
      paginationPages?.replaceChildren();
      if (previousButton) previousButton.disabled = currentPage <= 1;
      if (nextButton) nextButton.disabled = currentPage >= totalPages;
      for (const item of paginationItems(totalPages)) {
        if (typeof item === 'string') {
          const span = document.createElement('span');
          span.className = 'pagination-ellipsis';
          span.textContent = '…';
          paginationPages?.append(span);
          continue;
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `pagination-page${item === currentPage ? ' is-active' : ''}`;
        button.textContent = String(item);
        button.addEventListener('click', () => goToPage(item));
        paginationPages?.append(button);
      }
    }

    async function renderCurrent({ append = false } = {}) {
      const start = mode === 'pagination' ? (currentPage - 1) * PAGE_SIZE : (append ? Math.max(0, visibleCount - PAGE_SIZE) : 0);
      const end = mode === 'pagination' ? Math.min(start + PAGE_SIZE, resultTotal) : Math.min(visibleCount, resultTotal);
      const effectiveStart = append ? start : (mode === 'scroll' ? 0 : start);
      const ids = idsForRange(effectiveStart, end);
      const records = await recordsForIds(ids);
      const fragment = document.createDocumentFragment();
      for (const record of records) fragment.append(createEmojiCard(record));
      if (append) grid?.append(fragment); else grid?.replaceChildren(fragment);

      emptyState.hidden = resultTotal > 0;
      const shownEnd = mode === 'scroll' ? Math.min(visibleCount, resultTotal) : end;
      const shownStart = resultTotal ? (mode === 'pagination' ? start + 1 : 1) : 0;
      rangeCount.textContent = resultTotal
        ? `Showing ${shownStart.toLocaleString('en-US')}–${shownEnd.toLocaleString('en-US')} of ${resultTotal.toLocaleString('en-US')}`
        : 'No emoji found';
      if (infiniteStatus) infiniteStatus.textContent = `${shownEnd.toLocaleString('en-US')} of ${resultTotal.toLocaleString('en-US')} loaded`;
      renderPagination();
      updateModeUi();
      clearFilters.hidden = !hasFilters();
    }

    async function applyFilters(reason = 'filter', { silent = false } = {}) {
      if (busy) return;
      const term = search.value.trim();
      if (!silent) {
        if (reason === 'search' && term) {
          setLoading('Searching emoji…', `Finding “${term}” in the static search index.`);
        } else {
          setLoading('Filtering emoji…', 'Loading the matching facet shard and result chunks.');
        }
      }
      try {
        resultIds = await resolveIds();
        const manifest = await getManifest();
        resultTotal = resultIds ? resultIds.length : manifest.total;
        currentPage = 1;
        visibleCount = PAGE_SIZE;
        await renderCurrent();
        syncUrl();
      } catch (error) {
        console.error('Could not update emoji results', error);
        if (!silent) {
          if (loadingTitle) loadingTitle.textContent = 'Could not load results';
          if (loadingDetail) loadingDetail.textContent = 'Please retry the search or filter.';
          setTimeout(clearLoading, 1200);
        }
        return;
      }
      if (!silent) clearLoading();
    }

    async function loadMore() {
      if (busy || mode !== 'scroll' || visibleCount >= resultTotal) return;
      busy = true;
      infiniteSpinner?.classList.add('is-loading');
      if (loadMoreButton) loadMoreButton.disabled = true;
      if (infiniteStatus) infiniteStatus.textContent = 'Loading more emoji…';
      visibleCount = Math.min(visibleCount + PAGE_SIZE, resultTotal);
      try {
        await renderCurrent({ append: true });
      } finally {
        busy = false;
        infiniteSpinner?.classList.remove('is-loading');
        if (loadMoreButton) loadMoreButton.disabled = false;
      }
    }

    async function goToPage(page) {
      const totalPages = Math.max(1, Math.ceil(resultTotal / PAGE_SIZE));
      currentPage = Math.max(1, Math.min(page, totalPages));
      setLoading('Loading page…', `Loading page ${currentPage.toLocaleString('en-US')} from static catalog chunks.`);
      try {
        await renderCurrent();
        syncUrl();
        document.querySelector('#explorer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } finally {
        clearLoading();
      }
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters('search');
    });
    for (const control of [category, source, motion]) control?.addEventListener('change', () => applyFilters('filter'));
    clearFilters?.addEventListener('click', () => {
      search.value = '';
      category.value = '';
      source.value = '';
      motion.value = '';
      applyFilters('filter');
    });

    for (const button of modeButtons) {
      button.addEventListener('click', async () => {
        const nextMode = button.dataset.browseMode === 'pagination' ? 'pagination' : 'scroll';
        if (nextMode === mode) return;
        mode = nextMode;
        currentPage = 1;
        visibleCount = PAGE_SIZE;
        setLoading('Switching view…', mode === 'pagination' ? 'Preparing page navigation.' : 'Preparing continuous scrolling.');
        try {
          await renderCurrent();
          syncUrl();
        } finally {
          clearLoading();
        }
      });
    }

    previousButton?.addEventListener('click', () => goToPage(currentPage - 1));
    nextButton?.addEventListener('click', () => goToPage(currentPage + 1));
    loadMoreButton?.addEventListener('click', loadMore);

    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-copy]');
      if (!button) return;
      await navigator.clipboard.writeText(button.dataset.copy || '');
    });

    if ('IntersectionObserver' in window && infiniteLoader) {
      observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) loadMore();
      }, { rootMargin: '700px 0px' });
      observer.observe(infiniteLoader);
    }

    updateModeUi();
    clearFilters.hidden = !hasFilters();

    if (hasFilters() || currentPage > 1 || mode === 'pagination') {
      requestAnimationFrame(() => applyFilters(search.value.trim() ? 'search' : 'filter', { silent: true }));
    }
  </script>
</Layout>
