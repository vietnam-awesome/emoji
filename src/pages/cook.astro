---
import { withBase } from '../lib/url';

const base = import.meta.env.BASE_URL;
const kitchenUrl = withBase('/kitchen', base);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${kitchenUrl}`} />
    <link rel="canonical" href="https://emoji.eplus.dev/kitchen" />
    <title>Emoji Kitchen</title>
  </head>
  <body>
    <p>Moved to <a href={kitchenUrl}>Emoji Kitchen</a>.</p>
    <script is:inline define:vars={{ kitchenUrl }}>
      const target = new URL(kitchenUrl, window.location.origin);
      target.search = window.location.search;
      target.hash = window.location.hash;
      window.location.replace(target.toString());
    </script>
  </body>
</html>
