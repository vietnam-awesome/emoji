---
import Layout from '../layouts/Layout.astro';
import EmojiEditor from '../components/editor/EmojiEditor';
import { withBase } from '../lib/url';
import '../styles/editor.css';
import '../styles/editor-gif.css';
import '../styles/gif-timeline.css';

const base = import.meta.env.BASE_URL;
const homeUrl = withBase('/', base);
const browseUrl = withBase('/emojis', base);
---
<Layout
  title="Emoji editor — Crop, resize and edit animated GIF emoji"
  description="Edit emoji directly in your browser. Crop, resize, rotate, flip, include or exclude GIF frames, duplicate or delete frames, change frame delay and animation speed, then export PNG, WebP or animated GIF without uploading the image to a server."
  keywords={['emoji editor', 'GIF emoji editor', 'animated emoji', 'GIF frame editor', 'emoji crop', 'emoji resize', 'emoji maker', 'PNG emoji', 'WebP emoji']}
  breadcrumbs={[
    { name: 'Home', href: homeUrl },
    { name: 'Emoji editor' }
  ]}
>
  <script is:inline>
    (() => {
      try {
        const url = new URL(window.location.href);
        if (url.searchParams.get('handoff') !== 'cook' || url.searchParams.has('src')) return;
        const source = sessionStorage.getItem('eplus-emoji-editor-handoff');
        if (!source) return;
        const name = sessionStorage.getItem('eplus-emoji-editor-handoff-name') || 'cooked-emoji.png';
        url.searchParams.set('src', source);
        url.searchParams.set('name', name);
        history.replaceState({}, '', url);
        window.setTimeout(() => {
          const cleanUrl = new URL(window.location.href);
          cleanUrl.searchParams.delete('src');
          cleanUrl.searchParams.delete('handoff');
          history.replaceState({}, '', cleanUrl);
          sessionStorage.removeItem('eplus-emoji-editor-handoff');
          sessionStorage.removeItem('eplus-emoji-editor-handoff-name');
        }, 10000);
      } catch {
        // The editor remains usable even when browser storage is restricted.
      }
    })();
  </script>
  <section class="shell">
    <EmojiEditor browseUrl={browseUrl} client:only="react" />
  </section>
</Layout>