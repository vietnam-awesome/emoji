---
import Layout from '../layouts/Layout.astro';
import EmojiCard from '../components/EmojiCard.astro';
import CategoryPills from '../components/beui/CategoryPills';
import DeveloperGithubButton from '../components/beui/DeveloperGithubButton';
import HeroShuffleButton from '../components/beui/HeroShuffleButton';
import HomeSearchForm from '../components/beui/HomeSearchForm';
import { emojiAssetUrl } from '../lib/emojiAsset';
import { withBase } from '../lib/url';
import emojis from '../data/emojis.json';
import categories from '../data/categories.json';

const base = import.meta.env.BASE_URL;
const allEmojiUrl = withBase('/emojis', base);
const categoriesUrl = withBase('/categories', base);
const previewAssetBase = process.env.PREVIEW_ASSET_BASE_URL || '';
const animatedCount = emojis.filter((emoji) => emoji.animated).length;
const sourceCount = new Set(emojis.map((emoji) => emoji.source)).size;

const shuffle = (items) => {
  const pool = [...items];
  for (let index = pool.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [pool[index], pool[swapIndex]] = [pool[swapIndex], pool[index]];
  }
  return pool;
};

const heroPool = shuffle(emojis)
  .slice(0, Math.min(120, emojis.length))
  .map((emoji) => ({
    id: emoji.id,
    slug: emoji.slug,
    name: emoji.name,
    image: emojiAssetUrl(emoji, base),
    animated: Boolean(emoji.animated)
  }));
const showcase = heroPool.slice(0, 12);
const heroPoolIds = new Set(heroPool.map((emoji) => emoji.id));
const heroPoolJson = JSON.stringify(heroPool).replaceAll('<', '\\u003c');
const recent = [...emojis]
  .sort((a, b) => {
    const date = String(b.syncedAt || b.addedAt || '').localeCompare(String(a.syncedAt || a.addedAt || ''));
    return date || String(a.id || '').localeCompare(String(b.id || ''));
  })
  .slice(0, 12);
const animated = emojis.filter((emoji) => emoji.animated && !heroPoolIds.has(emoji.id)).slice(0, 12);
const topCategories = [...categories]
  .filter((category) => category.slug !== 'other')
  .sort((a, b) => b.count - a.count)
  .slice(0, 10);
const topCategoryItems = topCategories.map((category) => ({
  name: category.name,
  count: category.count,
  href: withBase(`/categories/${category.slug}`, base)
}));

const sections = [
  { title: 'Recently added', subtitle: 'The newest emoji from recent catalog syncs.', items: recent, href: allEmojiUrl },
  { title: 'Animated reactions', subtitle: 'GIFs and moving emoji for expressive conversations.', items: animated, href: `${allEmojiUrl}?motion=yes` }
];
---
<Layout
  title="ePlus Emoji — Searchable emoji, GIFs and reactions"
  description="Browse a fast, searchable library of animated GIF emoji, static emoji and reactions with source and license metadata."
>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="hero-content">
        <p class="hero-kicker">Open emoji directory</p>
        <h1>Emoji, organized.</h1>
        <p class="hero-lead">Search a growing library of custom emoji, reactions and GIFs. Every asset keeps its source, format and attribution metadata.</p>

        <div class="hero-search-shell" id="home-search-shell" data-asset-base={previewAssetBase}>
          <HomeSearchForm action={allEmojiUrl} client:load />
          <div class="home-search-results" id="home-search-results" aria-live="polite" hidden>
            <div class="home-search-results-head">
              <strong id="home-search-summary">Searching…</strong>
              <span>Top matches</span>
            </div>
            <div class="home-search-list" id="home-search-list"></div>
            <a class="home-search-all" id="home-search-all" href={allEmojiUrl}>View all results <span>→</span></a>
          </div>
        </div>

        <div class="hero-meta" aria-label="Library statistics">
          <span><strong>{emojis.length.toLocaleString('en-US')}</strong> emoji</span>
          <span><strong>{animatedCount.toLocaleString('en-US')}</strong> animated</span>
          <span><strong>{categories.length.toLocaleString('en-US')}</strong> categories</span>
          <span><strong>{sourceCount.toLocaleString('en-US')}</strong> sources</span>
        </div>
      </div>

      <div class="hero-library" aria-label="Emoji picks">
        <div class="hero-library-head">
          <div><span class="status-dot" aria-hidden="true"></span><strong>Emoji picks</strong></div>
          <div class="hero-library-actions">
            <span>{emojis.length.toLocaleString('en-US')} assets</span>
            <HeroShuffleButton client:load />
          </div>
        </div>
        <div class="hero-library-grid" id="hero-random-grid">
          {showcase.map((emoji) => (
            <a href={withBase(`/emoji/${emoji.slug}`, base)} data-beui-tooltip={emoji.name} aria-label={`Open ${emoji.name}`}>
              <img class="!size-16 !max-h-16 !max-w-16 object-contain" src={emoji.image} alt={emoji.name} loading="eager" width="64" height="64" />
              {emoji.animated && <span>GIF</span>}
            </a>
          ))}
        </div>
        <div class="hero-library-foot">
          <span>Randomized on every visit</span>
          <a href={allEmojiUrl}>Browse all →</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="hero-random-pool" set:html={heroPoolJson}></script>
  <script>
    import '../scripts/home.js';
  </script>

  <section class="shell category-section" aria-labelledby="category-title">
    <div class="section-heading-modern category-heading">
      <div><p class="section-kicker">Categories</p><h2 id="category-title">Browse popular collections</h2></div>
      <a href={categoriesUrl}>View all categories <span>→</span></a>
    </div>
    <CategoryPills client:visible items={topCategoryItems} />
  </section>

  {sections.map((section) => section.items.length > 0 && (
    <section class="shell emoji-section">
      <div class="section-heading-modern">
        <div><p class="section-kicker">Library</p><h2>{section.title}</h2><p>{section.subtitle}</p></div>
        <a href={section.href}>View all <span>→</span></a>
      </div>
      <div class="home-emoji-grid">
        {section.items.map((emoji) => <EmojiCard emoji={emoji} />)}
      </div>
    </section>
  ))}

  <section class="shell developer-banner">
    <div>
      <p class="section-kicker">Static search architecture</p>
      <h2>No runtime API or Worker required.</h2>
      <p>GitHub Actions generates a compact sharded search index, then deploys the static site to GitHub Pages.</p>
    </div>
    <div class="developer-actions"><DeveloperGithubButton client:visible /></div>
  </section>
</Layout>
