---
import Layout from '../layouts/Layout.astro';
import { emojiAssetUrl } from '../lib/emojiAsset';
import { withBase } from '../lib/url';
import emojis from '../data/catalog.js';
import categories from '../data/categories.json';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
const allEmojiUrl = withBase('/emojis', base);
const apiUrl = withBase('/api/emojis.json', base);
const animatedCount = emojis.filter((emoji) => emoji.animated).length;
const sourceCount = new Set(emojis.map((emoji) => emoji.source)).size;

const shuffle = (items) => {
  const pool = [...items];
  for (let index = pool.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [pool[index], pool[swapIndex]] = [pool[swapIndex], pool[index]];
  }
  return pool;
};

const heroPool = shuffle(emojis)
  .slice(0, Math.min(120, emojis.length))
  .map((emoji) => ({
    id: emoji.id,
    slug: emoji.slug,
    name: emoji.name,
    image: emojiAssetUrl(emoji, base),
    animated: emoji.animated
  }));
---
<Layout title="ePlus Emoji — Open emoji library" description="Browse, search and download a growing open emoji library from multiple sources.">
  <section class="home-hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Open emoji library</p>
      <h1>Find the right emoji, fast.</h1>
      <p class="hero-lede">Search {emojis.length.toLocaleString('en-US')} emoji from {sourceCount} sources, inspect metadata, and download local assets.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={allEmojiUrl}>Browse all emoji</a>
        <a class="button button-secondary" href={apiUrl}>Open JSON API</a>
      </div>
    </div>
    <div class="hero-orbit" aria-hidden="true">
      {heroPool.slice(0, 18).map((emoji, index) => (
        <img src={emoji.image} alt="" loading={index < 6 ? 'eager' : 'lazy'} class:list={['hero-orbit-emoji', { animated: emoji.animated }]} />
      ))}
    </div>
  </section>

  <section class="home-stats shell" aria-label="Catalog statistics">
    <article><strong>{emojis.length.toLocaleString('en-US')}</strong><span>emoji</span></article>
    <article><strong>{animatedCount.toLocaleString('en-US')}</strong><span>animated</span></article>
    <article><strong>{sourceCount}</strong><span>sources</span></article>
    <article><strong>{categories.length}</strong><span>groups</span></article>
  </section>

  <section class="home-preview shell">
    <div class="section-heading">
      <div><p class="eyebrow">Discover</p><h2>Random picks</h2></div>
      <a href={allEmojiUrl}>Explore catalog →</a>
    </div>
    <div class="home-emoji-grid">
      {heroPool.slice(18, 42).map((emoji) => (
        <a class="home-emoji-card" href={withBase(`/emoji/${emoji.slug}`, base)}>
          <img src={emoji.image} alt={emoji.name} loading="lazy" width="96" height="96" />
          <span>{emoji.name}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
