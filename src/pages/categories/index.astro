---
import Layout from '../../layouts/Layout.astro';
import CatalogBeuiEnhancer from '../../components/beui/CatalogBeuiEnhancer';
import categories from '../../data/categories.json';
import { categoryIcon } from '../../lib/category';
import { withBase } from '../../lib/url';

const base = import.meta.env.BASE_URL;
const sortedCategories = [...categories].sort((a, b) => {
  if (a.slug === 'other') return 1;
  if (b.slug === 'other') return -1;
  return b.count - a.count || a.name.localeCompare(b.name);
});
const totalAnimated = categories.reduce((sum, category) => sum + category.animated, 0);
const totalStatic = categories.reduce((sum, category) => sum + category.static, 0);
---
<Layout
  title="Emoji categories — ePlus Emoji"
  description="Explore the ePlus Emoji catalog by category, including reactions, animals, gaming, memes, people, food, travel and more."
>
  <section class="shell categories-page" aria-labelledby="categories-title">
    <header class="categories-header">
      <p class="eyebrow">Explore the library</p>
      <h1 id="categories-title">Emoji categories</h1>
      <p>Jump into a collection, compare static and animated counts, then browse the complete filtered catalog when you find the category you want.</p>
    </header>

    <div class="categories-summary" aria-label="Category statistics">
      <article><strong>{categories.length.toLocaleString('en-US')}</strong><span>categories</span></article>
      <article><strong>{totalAnimated.toLocaleString('en-US')}</strong><span>animated emoji</span></article>
      <article><strong>{totalStatic.toLocaleString('en-US')}</strong><span>static emoji</span></article>
    </div>

    <label class="search-box category-search beui-native-proxy-block" aria-hidden="true">
      <span class="search-icon" aria-hidden="true">⌕</span>
      <span class="sr-only">Filter categories</span>
      <input id="category-search" type="search" placeholder="Find a category" autocomplete="off" tabindex="-1" />
    </label>
    <CatalogBeuiEnhancer
      search={{ proxyId: 'category-search', placeholder: 'Find a category', label: 'Filter categories' }}
      className="beui-category-search-control"
      client:load
    />

    <div class="category-grid" id="category-grid">
      {sortedCategories.map((category) => {
        const ratio = category.count ? Math.round((category.animated / category.count) * 100) : 0;
        const categoryUrl = withBase(`/categories/${category.slug}`, base);
        return (
          <a
            class="category-card"
            href={categoryUrl}
            data-category-card
            data-category-search={`${category.name} ${category.slug}`.toLowerCase()}
          >
            <div class="category-card-head">
              <span class="category-icon" aria-hidden="true">{categoryIcon(category.slug)}</span>
              <span class="category-count">{category.count.toLocaleString('en-US')} emoji</span>
            </div>
            <div>
              <h2>{category.name}</h2>
              <p>{category.animated.toLocaleString('en-US')} animated · {category.static.toLocaleString('en-US')} static</p>
            </div>
            <div class="category-split" aria-label={`${ratio}% animated`} title={`${ratio}% animated`}>
              <span style={`--animated-ratio:${ratio}%`}></span>
            </div>
            <div class="category-card-foot"><span>{ratio}% animated</span><span>Explore →</span></div>
          </a>
        );
      })}
    </div>

    <div class="category-empty" id="category-empty" hidden>No matching category. Try a broader keyword.</div>
  </section>

  <script>
    const search = document.querySelector('#category-search');
    const cards = [...document.querySelectorAll('[data-category-card]')];
    const empty = document.querySelector('#category-empty');

    search?.addEventListener('input', () => {
      const query = String(search.value || '').trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const match = !query || String(card.dataset.categorySearch || '').includes(query);
        card.hidden = !match;
        if (match) visible += 1;
      }
      if (empty) empty.hidden = visible > 0;
    });
  </script>
</Layout>
