---
import Layout from '../layouts/Layout.astro';
import NotFoundExperience from '../components/beui/NotFoundExperience';
import { emojiAssetUrl } from '../lib/emojiAsset';
import { withBase } from '../lib/url';
import emojis from '../data/emojis.json';

const base = import.meta.env.BASE_URL;
const homeHref = withBase('/', base);
const browseHref = withBase('/emojis', base);

// Keep the 404 payload small while giving the client enough candidates to
// choose a fresh set on every visit. The pool is spread across the catalog so
// it is not biased toward the first source/category in the JSON file.
const visibleCount = Math.min(48, emojis.length);
const poolSize = Math.min(visibleCount * 3, emojis.length);
const step = Math.max(1, Math.floor(emojis.length / Math.max(poolSize, 1)));
const sampled = Array.from({ length: poolSize }, (_, index) => emojis[Math.min(index * step, emojis.length - 1)])
  .filter(Boolean)
  .map((emoji) => ({
    name: emoji.name,
    image: emojiAssetUrl(emoji, base),
    href: withBase(`/emoji/${emoji.slug}`, base),
    animated: Boolean(emoji.animated)
  }));
---
<Layout
  title="404 — Emoji not found | ePlus Emoji"
  description="The requested page could not be found. Browse the ePlus Emoji library instead."
>
  <NotFoundExperience
    homeHref={homeHref}
    browseHref={browseHref}
    items={sampled}
    visibleCount={visibleCount}
    client:load
  />
</Layout>
