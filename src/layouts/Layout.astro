---
import '../styles/global.css';
import '../styles/header-search.css';
import { withBase } from '../lib/url';
import CatalogDownload from '../components/CatalogDownload.astro';
import FilterCompatibility from '../components/FilterCompatibility.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ePlus Emoji',
  description = 'An open custom emoji directory for developers and communities.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? Astro.url.origin;
const homeUrl = withBase('/', base);
const emojisUrl = withBase('/emojis', base);
const categoriesUrl = withBase('/categories', base);
const faviconUrl = withBase('/favicon.svg', base);
const canonical = new URL(Astro.url.pathname, origin);
const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/\/+$/, '') || '/';
const normalizedBase = base === '/' ? '' : base.replace(/\/+$/, '');
const routePath = normalizedBase && normalizedPath.startsWith(normalizedBase)
  ? normalizedPath.slice(normalizedBase.length) || '/'
  : normalizedPath;
const isHome = routePath === '/';
const isEmojiDetail = routePath.startsWith('/emoji/');
const isBrowseIndex = routePath === '/emojis';
const isBrowse = isBrowseIndex || isEmojiDetail;
const isCategoriesIndex = routePath === '/categories';
const isCategoryDetail = routePath.startsWith('/categories/');
const isCategories = isCategoriesIndex || isCategoryDetail;
const isCollectionPage = isBrowseIndex || isCategoriesIndex || isCategoryDetail;

const absoluteHomeUrl = new URL(homeUrl, origin).toString();
const absoluteBrowseUrl = new URL(emojisUrl, origin).toString();
const absoluteCategoriesUrl = new URL(categoriesUrl, origin).toString();
const websiteId = `${absoluteHomeUrl}#website`;
const webpageId = `${canonical.toString()}#webpage`;

const schemaGraph = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: absoluteHomeUrl,
    name: 'ePlus Emoji',
    description: 'An open custom emoji directory for developers and communities.',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${absoluteBrowseUrl}?q={search_term_string}`
      },
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@type': isCollectionPage ? 'CollectionPage' : 'WebPage',
    '@id': webpageId,
    url: canonical.toString(),
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    ...(isBrowseIndex ? {
      about: { '@type': 'Thing', name: 'Custom emoji' },
      mainEntity: {
        '@type': 'ItemList',
        name: 'ePlus Emoji catalog',
        itemListOrder: 'https://schema.org/ItemListUnordered'
      }
    } : {})
  }
];

if (isBrowse || isCategories) {
  const itemListElement = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteHomeUrl }
  ];

  if (isBrowse) {
    itemListElement.push({ '@type': 'ListItem', position: 2, name: 'Browse', item: absoluteBrowseUrl });
    if (isEmojiDetail) {
      itemListElement.push({
        '@type': 'ListItem',
        position: 3,
        name: title.split('—')[0].trim(),
        item: canonical.toString()
      });
    }
  }

  if (isCategories) {
    itemListElement.push({ '@type': 'ListItem', position: 2, name: 'Categories', item: absoluteCategoriesUrl });
    if (isCategoryDetail) {
      itemListElement.push({
        '@type': 'ListItem',
        position: 3,
        name: title.split('—')[0].trim(),
        item: canonical.toString()
      });
    }
  }

  schemaGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement
  });
}

const schemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={schemaJson}></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z8VQQ5NSBH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z8VQQ5NSBH');
    </script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={homeUrl} aria-label="ePlus Emoji home">
          <span class="brand-mark" aria-hidden="true">😀</span>
          <span class="brand-copy">
            <strong>ePlus Emoji</strong>
            <small>Open emoji directory</small>
          </span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          <a class:list={[{ active: isHome }]} href={homeUrl} aria-current={isHome ? 'page' : undefined}>Home</a>
          <a class:list={[{ active: isBrowse }]} href={emojisUrl} aria-current={isBrowse ? 'page' : undefined}>Browse</a>
          <a class:list={[{ active: isCategories }]} href={categoriesUrl} aria-current={isCategories ? 'page' : undefined}>Categories</a>
        </nav>

        <div class="header-search" id="header-search">
          <button
            class="header-search-toggle"
            id="header-search-toggle"
            type="button"
            aria-label="Search emoji"
            aria-controls="header-search-panel"
            aria-expanded="false"
            title="Search emoji"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <form class="header-search-panel" id="header-search-panel" action={emojisUrl} method="get" role="search" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <input id="header-search-input" type="search" name="q" placeholder="Search emoji, tag or category" autocomplete="off" aria-label="Search emoji" />
            <button class="header-search-submit" type="submit">Search</button>
          </form>
        </div>
      </div>
    </header>

    <main><slot /></main>
    {isBrowseIndex && <FilterCompatibility />}
    {isBrowseIndex && <CatalogDownload />}

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <div class="footer-brand-title"><span class="brand-mark" aria-hidden="true">😀</span><strong>ePlus Emoji</strong></div>
          <p>Fast, searchable emoji assets for communities, apps and developer tooling.</p>
        </div>
        <div class="footer-links">
          <a href={emojisUrl}>Browse all</a>
          <a href={categoriesUrl}>Categories</a>
          <a href="https://github.com/vietnam-awesome/emoji/blob/main/NOTICE.md" rel="noreferrer">Licenses</a>
          <a href="https://github.com/vietnam-awesome/emoji" rel="noreferrer">Source</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>Built by ePlus.DEV</span>
        <span>Emoji assets retain their upstream attribution and licenses.</span>
      </div>
    </footer>

    <button class="back-to-top" id="back-to-top" type="button" aria-label="Back to top" title="Back to top" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.5 14.5 5.5-5.5 5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Top</span>
    </button>

    <script is:inline>
      (() => {
        const backToTop = document.querySelector('#back-to-top');
        const browseSearchInput = document.querySelector('#emoji-search');
        const homeSearchInput = document.querySelector('#home-emoji-search');
        const headerSearch = document.querySelector('#header-search');
        const headerSearchToggle = document.querySelector('#header-search-toggle');
        const headerSearchPanel = document.querySelector('#header-search-panel');
        const headerSearchInput = document.querySelector('#header-search-input');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let ticking = false;

        const openHeaderSearch = () => {
          if (!headerSearchPanel || !headerSearchToggle || !headerSearchInput) return;
          headerSearchPanel.hidden = false;
          headerSearchToggle.setAttribute('aria-expanded', 'true');
          window.requestAnimationFrame(() => {
            headerSearchInput.focus();
            headerSearchInput.select();
          });
        };

        const closeHeaderSearch = () => {
          if (!headerSearchPanel || !headerSearchToggle) return;
          headerSearchPanel.hidden = true;
          headerSearchToggle.setAttribute('aria-expanded', 'false');
        };

        headerSearchToggle?.addEventListener('click', () => {
          if (headerSearchPanel?.hidden) openHeaderSearch();
          else closeHeaderSearch();
        });

        document.addEventListener('pointerdown', (event) => {
          if (!headerSearchPanel || headerSearchPanel.hidden || headerSearch?.contains(event.target)) return;
          closeHeaderSearch();
        });

        const normalizeEmojiLabel = (value) => String(value || '')
          .toLowerCase()
          .normalize('NFKD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '');

        const hideRedundantPair = (nameNode, shortcodeNode) => {
          if (!nameNode || !shortcodeNode) return;
          const name = normalizeEmojiLabel(nameNode.textContent);
          const shortcode = normalizeEmojiLabel(String(shortcodeNode.textContent || '').replace(/^:+|:+$/g, ''));
          if (name && shortcode && name === shortcode) {
            shortcodeNode.hidden = true;
            shortcodeNode.setAttribute('aria-hidden', 'true');
            if ('tabIndex' in shortcodeNode) shortcodeNode.tabIndex = -1;
          }
        };

        const polishEmojiMetadata = (root) => {
          const cardNodes = [];
          const homeCardNodes = [];
          const suggestionNodes = [];
          if (root instanceof Element) {
            if (root.matches('.emoji-card')) cardNodes.push(root);
            if (root.matches('.home-emoji-card')) homeCardNodes.push(root);
            if (root.matches('.home-search-item')) suggestionNodes.push(root);
          }
          if (root.querySelectorAll) {
            cardNodes.push(...root.querySelectorAll('.emoji-card'));
            homeCardNodes.push(...root.querySelectorAll('.home-emoji-card'));
            suggestionNodes.push(...root.querySelectorAll('.home-search-item'));
          }
          for (const card of cardNodes) hideRedundantPair(card.querySelector('.emoji-name'), card.querySelector('.shortcode'));
          for (const card of homeCardNodes) hideRedundantPair(card.querySelector('.home-emoji-info strong'), card.querySelector('.home-emoji-info > span'));
          for (const item of suggestionNodes) hideRedundantPair(item.querySelector('.home-search-copy strong'), item.querySelector('.home-search-copy > span'));
        };

        polishEmojiMetadata(document);
        const metadataObserver = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            for (const node of mutation.addedNodes) {
              if (node instanceof Element) polishEmojiMetadata(node);
            }
          }
        });
        metadataObserver.observe(document.body, { childList: true, subtree: true });

        const syncBackToTop = () => {
          backToTop.hidden = window.scrollY < Math.max(560, window.innerHeight * 0.72);
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(syncBackToTop);
        }, { passive: true });

        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && headerSearchPanel && !headerSearchPanel.hidden) {
            closeHeaderSearch();
            headerSearchToggle?.focus();
            return;
          }

          if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
          const tag = document.activeElement?.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
          event.preventDefault();

          const pageSearch = browseSearchInput || homeSearchInput;
          if (pageSearch) {
            pageSearch.focus();
            pageSearch.select();
            return;
          }
          openHeaderSearch();
        });

        syncBackToTop();
      })();
    </script>
  </body>
</html>
