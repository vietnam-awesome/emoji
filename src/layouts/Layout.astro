---
import '../styles/beui.css';
import '../styles/catalog-pages.css';
import { withBase } from '../lib/url';
import CatalogDownload from '../components/CatalogDownload.astro';
import FilterCompatibility from '../components/FilterCompatibility.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SiteHeader from '../components/beui/SiteHeader';
import BackToTop from '../components/beui/BackToTop';
import EmojiQuickView from '../components/beui/EmojiQuickView.astro';
import EmojiPackDialog from '../components/beui/EmojiPackDialog.astro';

interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  keywords?: string[] | string;
  socialImage?: string;
  socialImageAlt?: string;
  breadcrumbs?: BreadcrumbItem[];
  robots?: string;
}

const defaultKeywords = [
  'emoji',
  'custom emoji',
  'animated emoji',
  'GIF emoji',
  'reaction emoji',
  'Slack emoji',
  'Discord emoji',
  'emoji download'
];
const publisherName = 'ePlus.DEV';
const publisherUrl = 'https://eplus.dev/';
const defaultSocialImageWidth = 1731;
const defaultSocialImageHeight = 909;

const {
  title = 'ePlus Emoji',
  description = 'An open custom emoji directory for developers and communities.',
  keywords = defaultKeywords,
  socialImage,
  socialImageAlt = 'ePlus Emoji — Open emoji directory',
  breadcrumbs,
  robots = 'index, follow'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? Astro.url.origin;
const homeUrl = withBase('/', base);
const emojisUrl = withBase('/emojis', base);
const categoriesUrl = withBase('/categories', base);
const favoritesUrl = withBase('/favorites', base);
const recentUrl = withBase('/recent', base);
const packsUrl = withBase('/packs', base);
const kitchenUrl = withBase('/kitchen', base);
const editorUrl = withBase('/editor', base);
const cutterUrl = withBase('/cutter', base);
const animatedEmojisUrl = `${emojisUrl}?motion=yes`;
const staticEmojisUrl = `${emojisUrl}?motion=no`;
const faviconIcoUrl = withBase('/favicon.ico', base);
const faviconPngUrl = withBase('/favicon-48x48.png', base);
const appleTouchIconUrl = withBase('/apple-touch-icon.png', base);
const manifestUrl = withBase('/site.webmanifest', base);
const defaultSocialImageUrl = withBase('/og-default.png', base);
const canonical = new URL(Astro.url.pathname, origin);
const absoluteSocialImageUrl = new URL(socialImage || defaultSocialImageUrl, origin).toString();
const keywordsText = Array.isArray(keywords) ? keywords.join(', ') : String(keywords || '');
const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/\/+$/, '') || '/';
const normalizedBase = base === '/' ? '' : base.replace(/\/+$/, '');
const routePath = normalizedBase && normalizedPath.startsWith(normalizedBase)
  ? normalizedPath.slice(normalizedBase.length) || '/'
  : normalizedPath;
const isHome = routePath === '/';
const isEmojiDetail = routePath.startsWith('/emoji/');
const isBrowseIndex = routePath === '/emojis';
const isBrowse = isBrowseIndex || isEmojiDetail;
const isCategoriesIndex = routePath === '/categories';
const isCategoryDetail = routePath.startsWith('/categories/');
const isCategories = isCategoriesIndex || isCategoryDetail;
const isFavorites = routePath === '/favorites';
const isRecent = routePath === '/recent';
const isPacks = routePath === '/packs';
const isCollectionPage = isBrowseIndex || isCategoriesIndex || isCategoryDetail;
const pageKind = isHome
  ? 'home'
  : isBrowseIndex
    ? 'browse'
    : isEmojiDetail
      ? 'emoji-detail'
      : isCategoriesIndex
        ? 'categories'
        : isCategoryDetail
          ? 'category-detail'
          : isFavorites
            ? 'favorites'
            : isRecent
              ? 'recent'
              : isPacks
                ? 'packs'
                : 'page';

const absoluteHomeUrl = new URL(homeUrl, origin).toString();
const absoluteBrowseUrl = new URL(emojisUrl, origin).toString();
const absoluteCategoriesUrl = new URL(categoriesUrl, origin).toString();
const publisherId = `${absoluteHomeUrl}#publisher`;
const websiteId = `${absoluteHomeUrl}#website`;
const webpageId = `${canonical.toString()}#webpage`;
const publisherLogoUrl = new URL(withBase('/android-chrome-512x512.png', base), origin).toString();

const defaultBreadcrumbs: BreadcrumbItem[] = [];
if (isBrowse) {
  defaultBreadcrumbs.push(
    { name: 'Home', href: homeUrl },
    { name: 'Browse', href: emojisUrl }
  );
  if (isEmojiDetail) {
    defaultBreadcrumbs.push({ name: title.split('—')[0].trim() });
  }
}
if (isFavorites) {
  defaultBreadcrumbs.push(
    { name: 'Home', href: homeUrl },
    { name: 'My Emoji' }
  );
}
if (isRecent) {
  defaultBreadcrumbs.push(
    { name: 'Home', href: homeUrl },
    { name: 'Recently viewed' }
  );
}
if (isPacks) {
  defaultBreadcrumbs.push(
    { name: 'Home', href: homeUrl },
    { name: 'Emoji Packs' }
  );
}
if (isCategories) {
  defaultBreadcrumbs.push(
    { name: 'Home', href: homeUrl },
    { name: 'Categories', href: categoriesUrl }
  );
  if (isCategoryDetail) {
    defaultBreadcrumbs.push({ name: title.split('—')[0].trim() });
  }
}
const breadcrumbItems: BreadcrumbItem[] = breadcrumbs?.length ? breadcrumbs : defaultBreadcrumbs;

const schemaGraph = [
  {
    '@type': 'Organization',
    '@id': publisherId,
    name: publisherName,
    url: publisherUrl,
    logo: {
      '@type': 'ImageObject',
      url: publisherLogoUrl,
      width: 512,
      height: 512
    }
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: absoluteHomeUrl,
    name: 'ePlus Emoji',
    description: 'An open custom emoji directory for developers and communities.',
    publisher: { '@id': publisherId },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${absoluteBrowseUrl}?q={search_term_string}`
      },
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@type': isCollectionPage ? 'CollectionPage' : 'WebPage',
    '@id': webpageId,
    url: canonical.toString(),
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    publisher: { '@id': publisherId },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: absoluteSocialImageUrl,
      width: defaultSocialImageWidth,
      height: defaultSocialImageHeight
    },
    ...(isBrowseIndex ? {
      about: { '@type': 'Thing', name: 'Custom emoji' },
      mainEntity: {
        '@type': 'ItemList',
        name: 'ePlus Emoji catalog',
        itemListOrder: 'https://schema.org/ItemListUnordered'
      }
    } : {})
  }
];

if (breadcrumbItems.length > 1) {
  schemaGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.href
        ? new URL(item.href, origin).toString()
        : canonical.toString()
    }))
  });
}

const schemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const key = 'eplus-emoji-theme';
          const saved = localStorage.getItem(key);
          const theme = saved === 'dark' || saved === 'light'
            ? saved
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const dark = theme === 'dark';
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = theme;
          document.documentElement.dataset.theme = theme;
        } catch {
          // localStorage can be unavailable in privacy-restricted contexts.
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="keywords" content={keywordsText} />
    <meta name="author" content={publisherName} />
    <meta name="publisher" content={publisherName} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ePlus Emoji" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteSocialImageUrl} />
    <meta property="og:image:secure_url" content={absoluteSocialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(defaultSocialImageWidth)} />
    <meta property="og:image:height" content={String(defaultSocialImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={absoluteSocialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" href={faviconIcoUrl} sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href={faviconPngUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
    <link rel="manifest" href={manifestUrl} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={schemaJson}></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z8VQQ5NSBH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z8VQQ5NSBH');
    </script>
    <title>{title}</title>
  </head>
  <body data-ui="beui" data-page={pageKind}>
    <SiteHeader
      homeUrl={homeUrl}
      emojisUrl={emojisUrl}
      categoriesUrl={categoriesUrl}
      routePath={routePath}
      client:load
    />

    <main>
      {breadcrumbItems.length > 1 && (
        <div class="shell">
          <Breadcrumb items={breadcrumbItems} />
        </div>
      )}
      <slot />
    </main>
    {isBrowseIndex && <FilterCompatibility />}
    <CatalogDownload />
    <EmojiQuickView />
    <EmojiPackDialog />

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <div class="footer-brand-title"><span class="brand-mark" aria-hidden="true">😀</span><strong>ePlus Emoji</strong></div>
          <p>Fast, searchable emoji assets for communities, apps and developer tooling.</p>
        </div>
        <div class="footer-links">
          <a href={emojisUrl}>Browse all</a>
          <a href={categoriesUrl}>Categories</a>
          <a href={favoritesUrl}>My Emoji</a>
          <a href={recentUrl}>Recently viewed</a>
          <a href={packsUrl}>Emoji Packs</a>
          <a href={kitchenUrl}>Kitchen</a>
          <a href={editorUrl}>Editor</a>
          <a href={cutterUrl}>Sheet Cutter</a>
          <a href={animatedEmojisUrl}>Animated</a>
          <a href={staticEmojisUrl}>Static</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>Built by ePlus.DEV</span>
        <span>Search, copy and download emoji for communities, apps and creative projects.</span>
      </div>
    </footer>

    <BackToTop client:load />

    <script>
      import '../scripts/favorites.js';
      import '../scripts/recent.js';
      import '../scripts/quick-view.js';
      import '../scripts/packs.js';
    </script>

    <script is:inline>
      (() => {
        const normalizeEmojiLabel = (value) => String(value || '')
          .toLowerCase()
          .normalize('NFKD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '');

        const hideRedundantPair = (nameNode, shortcodeNode) => {
          if (!nameNode || !shortcodeNode) return;
          const name = normalizeEmojiLabel(nameNode.textContent);
          const shortcode = normalizeEmojiLabel(String(shortcodeNode.textContent || '').replace(/^:+|:+$/g, ''));
          if (name && shortcode && name === shortcode) {
            shortcodeNode.hidden = true;
            shortcodeNode.setAttribute('aria-hidden', 'true');
            if ('tabIndex' in shortcodeNode) shortcodeNode.tabIndex = -1;
          }
        };

        const polishEmojiMetadata = (root) => {
          const cardNodes = [];
          const homeCardNodes = [];
          const suggestionNodes = [];
          if (root instanceof Element) {
            if (root.matches('.emoji-card')) cardNodes.push(root);
            if (root.matches('.home-emoji-card')) homeCardNodes.push(root);
            if (root.matches('.home-search-item')) suggestionNodes.push(root);
          }
          if (root.querySelectorAll) {
            cardNodes.push(...root.querySelectorAll('.emoji-card'));
            homeCardNodes.push(...root.querySelectorAll('.home-emoji-card'));
            suggestionNodes.push(...root.querySelectorAll('.home-search-item'));
          }
          for (const card of cardNodes) hideRedundantPair(card.querySelector('.emoji-name'), card.querySelector('.shortcode'));
          for (const card of homeCardNodes) hideRedundantPair(card.querySelector('.home-emoji-info strong'), card.querySelector('.home-emoji-info > span'));
          for (const item of suggestionNodes) hideRedundantPair(item.querySelector('.home-search-copy strong'), item.querySelector('.home-search-copy > span'));
        };

        polishEmojiMetadata(document);
        const metadataObserver = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            for (const node of mutation.addedNodes) {
              if (node instanceof Element) polishEmojiMetadata(node);
            }
          }
        });
        metadataObserver.observe(document.body, { childList: true, subtree: true });

        document.addEventListener('keydown', (event) => {
          if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
          const tag = document.activeElement?.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

          const visibleSearch = document.querySelector('[data-beui-visible-search], #home-emoji-search, #emoji-search:not(.beui-native-proxy), #category-search:not(.beui-native-proxy)');
          if (visibleSearch instanceof HTMLInputElement) {
            event.preventDefault();
            visibleSearch.focus();
            visibleSearch.select();
            return;
          }

          const headerSearch = document.querySelector('[data-header-search-toggle]');
          if (headerSearch instanceof HTMLButtonElement) {
            event.preventDefault();
            headerSearch.click();
          }
        });
      })();
    </script>
  </body>
</html>
